{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": { "@codemirror/*": ["../../../../node_modules/@codemirror/*"] },
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["main.ts", "src/**/*.ts"]
}
