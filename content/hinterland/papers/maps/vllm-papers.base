filters:
  and:
    - file.hasTag("vllm-offline")
    - file.inFolder("hinterland/papers/maps/papers")
    - file.ext == "md"
properties:
  note.cited_by:
    displayName: cited by
  file.tags:
    displayName: tags
views:
  - type: table
    name: papers
    groupBy:
      property: topic
      direction: ASC
    order:
      - title
      - author
      - arxiv
      - cited_by
      - pdf
    sort:
      - property: arxiv
        direction: ASC
    columnSize:
      note.title: 401
      note.author: 205
      note.arxiv: 130
      note.cited_by: 420
  - type: cards
    name: gallery
    groupBy:
      property: topic
      direction: ASC
    order:
      - title
      - author
      - arxiv
      - topic
    sort:
      - property: arxiv
        direction: ASC
    cardSize: 300
