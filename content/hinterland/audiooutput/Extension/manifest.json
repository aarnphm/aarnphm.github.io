{
  "manifest_version": 3,
  "name": "Audio Output",
  "version": "0.1.0",
  "description": "Route audio from selected sites through the Audio Output menu-bar app.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://music.youtube.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
