build:
    ./scripts/build.sh

icons:
    pnpm exec tsx scripts/build-icon.ts

run: build
    open "dist/Audio Output.app"

install: build
    swift scripts/install.swift
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "dist/Audio Output.app"
    mdimport "dist/Audio Output.app"
    mdimport "/Applications/Audio Output.app"

check:
    swift build
    plutil -lint Info.plist

probe:
    python3 scripts/verify-route.py

install-bridge: build
    python3 scripts/install-bridge.py

extension-check:
    node --check Extension/background.js
    node --check Extension/content.js
    node --check Extension/popup.js

bridge-check:
    python3 scripts/verify-bridge.py
