thrm {Q u e y} & \\mathrm {Q} \\end{array} \\\\ \\end{array}\n$$"}], "24": [{"bbox": [10.0, 28.0, 278.0, 102.0], "text": "Attention: Training"}, {"bbox": [70.0, 161.0, 288.0, 220.0], "text": "L : sequence length"}, {"bbox": [70.0, 231.0, 356.0, 288.0], "text": "d : hidden state dimension"}, {"bbox": [11.0, 370.0, 303.0, 433.0], "text": "$$\nO \\left(L ^ {2} d\\right) \\quad \\mathbf {O} = \\mathbf {A V} \\in \\mathbb {R} ^ {L \\times d}\n$$"}, {"bbox": [10.0, 561.0, 461.0, 627.0], "text": "$$\nO \\left(L ^ {2} d\\right) \\quad \\mathbf {A} = \\operatorname {s o f t m a x} \\left(\\mathbf {Q K} ^ {\\top} \\odot \\mathbf {M}\\right) \\in \\mathbb {R} ^ {L \\times L}\n$$"}, {"bbox": [8.0, 743.0, 418.0, 959.0], "text": "$$\n\\begin{array}{l} O \\left(L d ^ {2}\\right) \\quad \\mathbf {Q}, \\mathbf {K}, \\mathbf {V} = \\mathbf {X} \\boldsymbol {W} _ {Q}, \\mathbf {X} \\boldsymbol {W} _ {K}, \\mathbf {X} \\boldsymbol {W} _ {V} \\\\ \\mathbf {X} \\in \\mathbb {R} ^ {L \\times d} \\quad \\begin{array}{c c c} \\mathrm {K e y} & \\mathrm {K} \\\\ \\mathrm {V a l u e} & \\mathrm {V} \\\\ \\mathrm {Q u e y} & \\mathrm {Q} \\end{array} \\\\ \\end{array}\n$$"}], "25": [{"bbox": [11.0, 29.0, 279.0, 99.0], "text": "## Attention: Training"}, {"bbox": [44.0, 176.0, 879.0, 301.0], "text": "Attention requires $O ( L^{2} d+L d^{2})$ work but can be done in O(1) steps $\\rightarrow$ Parallel training that is rich in matmuls."}, {"bbox": [12.0, 371.0, 304.0, 433.0], "text": "$$\nO \\left(L ^ {2} d\\right) \\quad \\mathbf {O} = \\mathbf {A V} \\in \\mathbb {R} ^ {L \\times d}\n$$"}, {"bbox": [11.0, 560.0, 462.0, 626.0], "text": "$$\nO \\left(L ^ {2} d\\right) \\quad \\mathbf {A} = \\operatorname {s o f t m a x} \\left(\\mathbf {Q K} ^ {\\top} \\odot \\mathbf {M}\\right) \\in \\mathbb {R} ^ {L \\times L}\n$$"}, {"bbox": [12.0, 744.0, 418.0, 806.0], "text": "$$\nO \\left(L d ^ {2}\\right) \\quad \\mathbf {Q}, \\mathbf {K}, \\mathbf {V} = \\mathbf {X} \\boldsymbol {W} _ {Q}, \\mathbf {X} \\boldsymbol {W} _ {K}, \\mathbf {X} \\boldsymbol {W} _ {V}\n$$"}, {"bbox": [126.0, 886.0, 230.0, 943.0], "text": "$$\n\\mathbf {X} \\in \\mathbb {R} ^ {L \\times d}\n$$"}, {"bbox": [547.0, 577.0, 885.0, 751.0], "text": "Attention: Number sequential operations is independent of sequence length!"}], "26": [{"bbox": [12.0, 30.0, 277.0, 100.0], "text": "Attention: Training"}, {"bbox": [33.0, 147.0, 859.0, 708.0], "text": "<table border=\"1\"><tr><td colspan=\"3\">Training(“Parallel Form”)\nO=softmax((QKT)⊙M)V</td></tr><tr><td>Compute(Work)</td><td>O(L2)</td><td>(FLOPs)</td></tr><tr><td>Memory</td><td>O(L)</td><td>(GPU memory)</td></tr><tr><td>Steps</td><td>O(1)</td><td>(Number of matmuls)</td></tr></table>"}], "27": [{"bbox": [11.0, 31.0, 462.0, 96.0], "text": "Attention: Generative Inference"}, {"bbox": [87.0, 704.0, 416.0, 753.0], "text": "$$\n\\boldsymbol {q} _ {t}, \\boldsymbol {k} _ {t}, \\boldsymbol {v} _ {t} = \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {Q}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {K}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {V}\n$$"}], "28": [{"bbox": [11.0, 31.0, 462.0, 96.0], "text": "Attention: Generative Inference"}, {"bbox": [86.0, 704.0, 416.0, 753.0], "text": "$$\n\\boldsymbol {q} _ {t}, \\boldsymbol {k} _ {t}, \\boldsymbol {v} _ {t} = \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {Q}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {K}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {V}\n$$"}], "29": [{"bbox": [11.0, 31.0, 462.0, 95.0], "text": "Attention: Generative Inference"}, {"bbox": [171.0, 410.0, 321.0, 523.0], "text": "$$\n\\frac {\\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right)}{\\sum_ {l = 1} ^ {t} \\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {l}\\right)}\n$$"}, {"bbox": [87.0, 704.0, 416.0, 752.0], "text": "$$\n\\boldsymbol {q} _ {t}, \\boldsymbol {k} _ {t}, \\boldsymbol {v} _ {t} = \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {Q}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {K}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {V}\n$$"}], "3": [{"bbox": [11.0, 27.0, 567.0, 103.0], "text": "How do large language models work?"}], "30": [{"bbox": [11.0, 32.0, 462.0, 95.0], "text": "Attention: Generative Inference"}, {"bbox": [86.0, 406.0, 342.0, 528.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\frac {\\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right)}{\\sum_ {l = 1} ^ {t} \\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {l}\\right)} \\boldsymbol {v} _ {j}\n$$"}, {"bbox": [87.0, 704.0, 416.0, 752.0], "text": "$$\n\\boldsymbol {q} _ {t}, \\boldsymbol {k} _ {t}, \\boldsymbol {v} _ {t} = \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {Q}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {K}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {V}\n$$"}], "31": [{"bbox": [11.0, 31.0, 462.0, 95.0], "text": "## Attention: Generative Inference"}, {"bbox": [86.0, 406.0, 343.0, 528.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\frac {\\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right)}{\\sum_ {l = 1} ^ {t} \\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {l}\\right)} \\boldsymbol {v} _ {j}\n$$"}, {"bbox": [87.0, 704.0, 416.0, 753.0], "text": "$$\n\\boldsymbol {q} _ {t}, \\boldsymbol {k} _ {t}, \\boldsymbol {v} _ {t} = \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {Q}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {K}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {V}\n$$"}], "32": [{"bbox": [11.0, 31.0, 462.0, 95.0], "text": "## Attention: Generative Inference"}, {"bbox": [86.0, 406.0, 343.0, 528.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\frac {\\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right)}{\\sum_ {l = 1} ^ {t} \\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {l}\\right)} \\boldsymbol {v} _ {j}\n$$"}], "33": [{"bbox": [11.0, 31.0, 462.0, 95.0], "text": "Attention: Generative Inference"}, {"bbox": [86.0, 405.0, 342.0, 528.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\frac {\\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right)}{\\sum_ {l = 1} ^ {t} \\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {l}\\right)} \\boldsymbol {v} _ {j}\n$$"}, {"bbox": [87.0, 704.0, 416.0, 752.0], "text": "$$\n\\boldsymbol {q} _ {t}, \\boldsymbol {k} _ {t}, \\boldsymbol {v} _ {t} = \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {Q}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {K}, \\boldsymbol {x} _ {t} \\boldsymbol {W} _ {V}\n$$"}], "34": [{"bbox": [11.0, 32.0, 462.0, 95.0], "text": "Attention: Generative Inference"}, {"bbox": [86.0, 406.0, 343.0, 527.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\frac {\\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right)}{\\sum_ {l = 1} ^ {t} \\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {l}\\right)} \\boldsymbol {v} _ {j}\n$$"}, {"bbox": [85.0, 702.0, 416.0, 948.0], "text": "<table border=\"1\"><tr><td>$q_{t}, k_{t}, v_{t}=x_{t}W_{Q}, x_{t}W_{K}, x_{t}W_{V}$</td></tr><tr><td>Key</td><td>K</td></tr><tr><td>Value</td><td>V</td></tr><tr><td>Query</td><td>Q</td></tr></table>"}], "35": [{"bbox": [11.0, 31.0, 462.0, 96.0], "text": "Attention: Generative Inference"}, {"bbox": [86.0, 405.0, 342.0, 528.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\frac {\\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right)}{\\sum_ {l = 1} ^ {t} \\exp \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {l}\\right)} \\boldsymbol {v} _ {j}\n$$"}, {"bbox": [489.0, 365.0, 897.0, 486.0], "text": "Need to keep around \"KV-cache\" that takes O(L) memory."}, {"bbox": [84.0, 700.0, 417.0, 951.0], "text": "<table border=\"1\"><tr><td>$q_{t}, k_{t}, v_{t}=x_{t}W_{Q}, x_{t}W_{K}, x_{t}W_{V}$</td></tr><tr><td>Key</td><td>K</td></tr><tr><td>Value</td><td>V</td></tr><tr><td>Query</td><td>Q</td></tr></table>"}], "36": [{"bbox": [12.0, 30.0, 149.0, 95.0], "text": "## Attention"}, {"bbox": [33.0, 149.0, 971.0, 707.0], "text": "<table border=\"1\"><tr><td></td><td colspan=\"2\">Training(“Parallel Form”)\nO=softmax((QK$ ^{\\top} $) $\\odot$ M)V</td><td>Inference(“Recurrent Form”)\no$ _{t} $=$ $\\frac{\\sum_{i=1}^{t}\\exp(q_{t}k_{i}^{\\top})v_{i}}{\\sum_{i=1}^{t}\\exp(q_{t}k_{i}^{\\top})}$</td></tr><tr><td>Compute(Work)</td><td colspan=\"2\">O(L$ ^{2} $)</td><td>O(L$ ^{2} $)</td></tr><tr><td>Memory</td><td colspan=\"2\">O(L)</td><td>O(L)</td></tr><tr><td>Steps</td><td colspan=\"2\">O(1)</td><td>O(L)</td></tr></table>"}], "37": [{"bbox": [12.0, 31.0, 149.0, 96.0], "text": "## Attention"}, {"bbox": [34.0, 155.0, 970.0, 695.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)\nO=softmax((QKT)⊙M)V</td><td>Inference(“Recurrent Form”)\no_t=\\frac{\\sum_{i=1}^{t}\\exp(q_tk_i^{\\top})v_i}{\\sum_{i=1}^{t}\\exp(q_tk_i^{\\top})}$</td></tr><tr><td>Compute(Work)</td><td>O(L2)</td><td>O(L2)</td></tr><tr><td>Memory</td><td>O(L)</td><td>O(L)</td></tr><tr><td>Steps</td><td>O(1)</td><td>O(L)</td></tr></table>"}, {"bbox": [24.0, 750.0, 964.0, 808.0], "text": "Attention enables scalable training of accurate sequence models, but requires:"}, {"bbox": [37.0, 811.0, 653.0, 867.0], "text": "Quadratic compute (bad for training / inference)."}, {"bbox": [38.0, 871.0, 490.0, 929.0], "text": "Linear memory (bad for inference)."}], "38": [{"bbox": [13.0, 28.0, 828.0, 101.0], "text": "Linear Attention (\"Linear Transformers\") [Katharopoulos et al. '20]"}, {"bbox": [55.0, 381.0, 163.0, 495.0], "text": "Softmax Attention"}, {"bbox": [375.0, 388.0, 686.0, 456.0], "text": "$$\n\\mathbf {O} = \\operatorname {s o f t m a x} \\left(\\left(\\mathbf {Q K} ^ {\\mathrm {T}}\\right) \\odot \\mathbf {M}\\right) \\mathbf {V}\n$$"}, {"bbox": [55.0, 606.0, 230.0, 719.0], "text": "(Simple) Linear Attention"}, {"bbox": [402.0, 616.0, 640.0, 688.0], "text": "$$\n\\mathbf {O} = \\left(\\left(\\mathbf {Q K} ^ {\\top}\\right) \\odot \\mathbf {M}\\right) \\mathbf {V}\n$$"}], "39": [{"bbox": [13.0, 27.0, 828.0, 101.0], "text": "Linear Attention (\"Linear Transformers\") [Katharopoulos et al. '20]"}, {"bbox": [55.0, 380.0, 164.0, 496.0], "text": "Softmax Attention"}, {"bbox": [55.0, 605.0, 230.0, 720.0], "text": "(Simple) Linear Attention"}], "4": [{"bbox": [11.0, 29.0, 566.0, 102.0], "text": "How do large language models work?"}], "40": [{"bbox": [12.0, 20.0, 827.0, 172.0], "text": "Linear Attention (\"Linear Transformers\") [Katharopoulos et al. '20]"}, {"bbox": [42.0, 200.0, 629.0, 779.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)</td></tr><tr><td>Softmax Attention</td><td>O=softmax((QK^{T})\\odot M)V</td></tr><tr><td>(Simple) Linear Attention</td><td>O=((QK^{T})\\odot M)V</td></tr></table>"}, {"bbox": [653.0, 446.0, 918.0, 570.0], "text": "Training: Haven't really gained anything (yet)..."}], "41": [{"bbox": [11.0, 27.0, 829.0, 100.0], "text": "Linear Attention (\"Linear Transformers\") [Katharopoulos et al. '20]"}, {"bbox": [38.0, 195.0, 961.0, 773.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)</td><td>Inference(“Recurrent Form”)</td></tr><tr><td>Softmax Attention</td><td>O=softmax((QKT)⊙M)V</td><td>o_t=\\sum_{j=1}^{t}\\frac{\\exp(q_t^{\\top}k_j)} {\\sum_{l=1}^{t}\\exp(q_t^{\\top}k_l)v_j}$</td></tr><tr><td>(Simple) Linear Attention</td><td>O=((QKT)⊙M)V</td><td>o_t=\\sum_{j=1}^{t}(q_t^{\\top}k_j)v_j</td></tr></table>"}], "42": [{"bbox": [12.0, 28.0, 828.0, 100.0], "text": "Linear Attention (\"Linear Transformers\") [Katharopoulos et al. '20]"}, {"bbox": [39.0, 197.0, 961.0, 763.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)</td><td>Inference(“Recurrent Form”)</td></tr><tr><td>Softmax Attention</td><td>O=softmax((QKT)⊙M)V</td><td>o_t=\\sum_{j=1}^{t}\\frac{\\exp(q_t^{T}k_j)} {\\sum_{l=1}^{t}\\exp(q_t^{T}k_l)}v_j</td></tr><tr><td>(Simple) Linear Attention</td><td>O=((QKT)⊙M)V</td><td>o_t=\\sum_{j=1}^{t}(q_t^{T}k_j)v_j</td></tr></table>"}], "43": [{"bbox": [14.0, 31.0, 395.0, 96.0], "text": "Linear Attention: Inference"}, {"bbox": [37.0, 249.0, 250.0, 406.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j}\n$$"}], "44": [{"bbox": [13.0, 31.0, 397.0, 96.0], "text": "Linear Attention: Inference"}, {"bbox": [36.0, 232.0, 463.0, 418.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)\n$$"}], "45": [{"bbox": [12.0, 31.0, 397.0, 96.0], "text": "Linear Attention: Inference"}, {"bbox": [37.0, 231.0, 471.0, 488.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\underbrace {\\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)} _ {\\mathbf {S} _ {t} \\in \\mathbb {R} ^ {d \\times d}}\n$$"}], "46": [{"bbox": [14.0, 32.0, 397.0, 94.0], "text": "Linear Attention: Inference"}, {"bbox": [37.0, 231.0, 470.0, 488.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\underbrace {\\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)} _ {\\mathbf {S} _ {t} \\in \\mathbb {R} ^ {d \\times d}}\n$$"}, {"bbox": [43.0, 510.0, 266.0, 582.0], "text": "$$\n\\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} v _ {t} ^ {\\top}\n$$"}, {"bbox": [44.0, 596.0, 176.0, 670.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\boldsymbol {q} _ {t} ^ {\\intercal} \\mathbf {S} _ {t}\n$$"}], "47": [{"bbox": [14.0, 31.0, 396.0, 95.0], "text": "Linear Attention: Inference"}, {"bbox": [38.0, 230.0, 470.0, 488.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\underbrace {\\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)} _ {\\mathbf {S} _ {t} \\in \\mathbb {R} ^ {d \\times d}}\n$$"}, {"bbox": [44.0, 510.0, 266.0, 583.0], "text": "$$\n\\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} v _ {t} ^ {\\top}\n$$"}, {"bbox": [44.0, 595.0, 176.0, 672.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\boldsymbol {q} _ {t} ^ {\\intercal} \\mathbf {S} _ {t}\n$$"}, {"bbox": [799.0, 115.0, 928.0, 277.0], "text": "Value V\n\nQuery Q"}], "48": [{"bbox": [14.0, 31.0, 396.0, 95.0], "text": "Linear Attention: Inference"}, {"bbox": [38.0, 230.0, 472.0, 488.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\underbrace {\\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)} _ {\\mathbf {S} _ {t} \\in \\mathbb {R} ^ {d \\times d}}\n$$"}, {"bbox": [44.0, 510.0, 266.0, 583.0], "text": "$$\n\\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} v _ {t} ^ {\\top}\n$$"}, {"bbox": [44.0, 596.0, 175.0, 671.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\boldsymbol {q} _ {t} ^ {\\top} \\mathbf {S} _ {t}\n$$"}, {"bbox": [800.0, 116.0, 928.0, 276.0], "text": "Value V\n\nQuery Q"}], "49": [{"bbox": [14.0, 31.0, 396.0, 95.0], "text": "Linear Attention: Inference"}, {"bbox": [38.0, 231.0, 471.0, 488.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\underbrace {\\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)} _ {\\mathbf {S} _ {t} \\in \\mathbb {R} ^ {d \\times d}}\n$$"}, {"bbox": [44.0, 510.0, 266.0, 583.0], "text": "$$\n\\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} v _ {t} ^ {\\top}\n$$"}, {"bbox": [44.0, 595.0, 176.0, 671.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\boldsymbol {q} _ {t} ^ {\\top} \\mathbf {S} _ {t}\n$$"}, {"bbox": [799.0, 116.0, 928.0, 276.0], "text": "Value V\n\nQuery Q"}], "5": [{"bbox": [11.0, 28.0, 568.0, 103.0], "text": "How do large language models work?"}], "50": [{"bbox": [14.0, 31.0, 397.0, 95.0], "text": "Linear Attention: Inference"}, {"bbox": [37.0, 231.0, 472.0, 488.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\underbrace {\\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)} _ {\\mathbf {S} _ {t} \\in \\mathbb {R} ^ {d \\times d}}\n$$"}, {"bbox": [41.0, 509.0, 268.0, 671.0], "text": "$$\n\\begin{array}{l} \\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} \\boldsymbol {v} _ {t} ^ {\\top} \\\\ o _ {t} = q _ {t} ^ {\\top} \\mathbf {S} _ {t} \\\\ \\end{array}\n$$"}, {"bbox": [799.0, 115.0, 929.0, 276.0], "text": "Value V\n\nQuery Q"}], "51": [{"bbox": [13.0, 31.0, 397.0, 95.0], "text": "Linear Attention: Inference"}, {"bbox": [37.0, 229.0, 473.0, 487.0], "text": "$$\n\\boldsymbol {o} _ {t} = \\sum_ {j = 1} ^ {t} \\left(\\boldsymbol {q} _ {t} ^ {\\top} \\boldsymbol {k} _ {j}\\right) \\boldsymbol {v} _ {j} = \\boldsymbol {q} _ {t} ^ {\\top} \\underbrace {\\left(\\sum_ {j = 1} ^ {t} \\boldsymbol {k} _ {j} \\boldsymbol {v} _ {j} ^ {\\top}\\right)} _ {\\mathbf {S} _ {t} \\in \\mathbb {R} ^ {d \\times d}}\n$$"}, {"bbox": [42.0, 509.0, 268.0, 671.0], "text": "$$\n\\begin{array}{l} \\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} \\boldsymbol {v} _ {t} ^ {\\top} \\\\ o _ {t} = q _ {t} ^ {\\top} \\mathbf {S} _ {t} \\\\ \\end{array}\n$$"}, {"bbox": [32.0, 749.0, 468.0, 925.0], "text": "Linear Attention = Linear RNNs with matrix-valued hidden states $\\rightarrow$ Constant-memory inference!"}], "52": [{"bbox": [13.0, 28.0, 583.0, 98.0], "text": "Linear Transformers are \"Fast Weights\"!"}, {"bbox": [39.0, 220.0, 515.0, 277.0], "text": "Using Fast Weights to Deblur Old Memories"}, {"bbox": [140.0, 344.0, 413.0, 385.0], "text": "Geoffrey E. Hinton and David C. Plaut"}, {"bbox": [579.0, 201.0, 903.0, 318.0], "text": "LEARNING TO CONTROL FAST-WEIGHT MEMORIES: AN ALTERNATIVE TO DYNAMIC RECURRENT NETWORKS"}, {"bbox": [167.0, 409.0, 385.0, 484.0], "text": "Computer Science Department Carnegie-Mellon University"}, {"bbox": [655.0, 329.0, 829.0, 356.0], "text": "(Neural Computation, 4(1):131-139, 1992)"}, {"bbox": [620.0, 378.0, 863.0, 507.0], "text": "Jürgen Schmidhuber*\n\nInstitut für Informatik\n\nTechnische Universität München\n\nArcisstr. 21, 8000 München 2, Germany\n\nschmidhu@tumult.informatik.tu-muenchen.de"}, {"bbox": [174.0, 566.0, 362.0, 613.0], "text": "[Hinton and Plaut '87]"}, {"bbox": [671.0, 567.0, 832.0, 612.0], "text": "[Schmidhuber '92]"}, {"bbox": [49.0, 731.0, 337.0, 917.0], "text": "A \"slow network\" changes the weights of a \"fast network\""}, {"bbox": [340.0, 691.0, 674.0, 763.0], "text": "$$\n\\boldsymbol {a} ^ {(i)}, \\boldsymbol {b} ^ {(i)} = \\boldsymbol {W} _ {a} \\boldsymbol {x} ^ {(i)}, \\boldsymbol {W} _ {b} \\boldsymbol {x} ^ {(i)}\n$$"}, {"bbox": [372.0, 777.0, 773.0, 855.0], "text": "$$\n\\boldsymbol {W} ^ {(i)} = \\sigma \\left(\\boldsymbol {W} ^ {(i - 1)} + \\boldsymbol {a} ^ {(i)} \\otimes \\boldsymbol {b} ^ {(i)}\\right)\n$$"}, {"bbox": [393.0, 863.0, 592.0, 934.0], "text": "$$\n\\boldsymbol {y} ^ {(i)} = \\boldsymbol {W} ^ {(i)} \\boldsymbol {x} ^ {(i)}\n$$"}], "53": [{"bbox": [14.0, 30.0, 246.0, 96.0], "text": "Linear Attention"}, {"bbox": [33.0, 149.0, 967.0, 705.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)\nO=((QKT)⊙M)V</td><td>Inference(“Recurrent Form”)\nS_t=S_{t-1}+k_tv_t^{T}\no_t=q_t^{T}S_t</td></tr><tr><td>Compute</td><td>O(L^2)</td><td>O(L)</td></tr><tr><td>Memory</td><td>O(L)</td><td>O(1)笑</td></tr><tr><td>Steps</td><td>O(1)</td><td>O(L)</td></tr></table>"}], "54": [{"bbox": [14.0, 28.0, 537.0, 98.0], "text": "Linear Attention: Naive Parallel Form"}, {"bbox": [33.0, 148.0, 965.0, 711.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)\nO=((QKT)⊙M)V</td><td>Inference(“Recurrent Form”)\nS_t=S_{t-1}+k_tv_tT\no_t=q_tTSt</td></tr><tr><td>Compute</td><td>O(L2)</td><td>O(L)</td></tr><tr><td>Memory</td><td>O(L)</td><td>O(1)</td></tr><tr><td>Steps</td><td>O(1)</td><td>O(L)</td></tr></table>"}, {"bbox": [265.0, 758.0, 794.0, 823.0], "text": "Why not use the recurrent form for training?"}], "55": [{"bbox": [14.0, 29.0, 537.0, 97.0], "text": "Linear Attention: Naive Parallel Form"}, {"bbox": [32.0, 148.0, 963.0, 704.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)\nO=((QKT)⊙M)V</td><td>Inference(“Recurrent Form”)\nS_t=S_{t-1}+k_tv_t^{T}\no_t=q_t^{T}S_t</td></tr><tr><td>Compute</td><td>O(L2)</td><td>O(L)</td></tr><tr><td>Memory</td><td>O(L)</td><td>O(1)</td></tr><tr><td>Steps</td><td>O(1)</td><td>O(L)</td></tr></table>"}, {"bbox": [34.0, 731.0, 804.0, 792.0], "text": "- Strict sequential computation (no sequence-level parallelism)."}], "56": [{"bbox": [14.0, 30.0, 537.0, 97.0], "text": "Linear Attention: Naive Parallel Form"}, {"bbox": [33.0, 147.0, 963.0, 699.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)\nO=((QKT)⊙M)V</td><td>Inference(“Recurrent Form”)\nSt=St-1+ktvT\no_t=qtTS_t</td></tr><tr><td>Compute</td><td>O(L2)</td><td>O(L)</td></tr><tr><td>Memory</td><td>O(L)</td><td>O(1)</td></tr><tr><td>Steps</td><td>O(1)</td><td>O(L)</td></tr></table>"}, {"bbox": [35.0, 732.0, 804.0, 789.0], "text": "- Strict sequential computation (no sequence-level parallelism)."}, {"bbox": [35.0, 793.0, 942.0, 909.0], "text": "- All operations are either elementwise operations or reductions $\\rightarrow$ cannot leverage tensor cores."}], "57": [{"bbox": [14.0, 29.0, 537.0, 97.0], "text": "Linear Attention: Naive Parallel Form"}, {"bbox": [33.0, 148.0, 989.0, 698.0], "text": "<table border=\"1\"><tr><td></td><td>Training(“Parallel Form”)\nO=((QKT)⊙M)V</td><td>Inference(“Recurrent Form”)\nSt=St-1+ktvT\no_t=qTSt</td></tr><tr><td>Compute</td><td>O(L2)</td><td>O(L)</td></tr><tr><td>Memory</td><td>O(L)</td><td>O(1)</td></tr><tr><td>Steps</td><td>O(1)</td><td>O(L)</td></tr></table>"}, {"bbox": [35.0, 733.0, 804.0, 789.0], "text": "- Strict sequential computation (no sequence-level parallelism)."}, {"bbox": [35.0, 794.0, 939.0, 905.0], "text": "- All operations are either elementwise operations or reductions $\\rightarrow$ cannot leverage tensor cores."}, {"bbox": [35.0, 911.0, 859.0, 968.0], "text": "- Materialization of each time step's hidden states $\\rightarrow$ High I/O cost."}], "58": [{"bbox": [17.0, 31.0, 929.0, 210.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23] Pure RNN·"}], "59": [{"bbox": [13.0, 31.0, 929.0, 96.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23]"}], "6": [{"bbox": [10.0, 28.0, 567.0, 103.0], "text": "How do large language models work?"}], "60": [{"bbox": [14.0, 32.0, 928.0, 95.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23]"}, {"bbox": [20.0, 151.0, 404.0, 208.0], "text": "Step 1: local state computation"}], "61": [{"bbox": [14.0, 31.0, 928.0, 96.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23]"}, {"bbox": [21.0, 151.0, 284.0, 209.0], "text": "Step 2: state passing"}, {"bbox": [128.0, 341.0, 213.0, 389.0], "text": "Chunk 1"}, {"bbox": [260.0, 449.0, 297.0, 501.0], "text": "$$\n\\mathbf {S} _ {[ 1 ]}\n$$"}], "62": [{"bbox": [15.0, 32.0, 927.0, 96.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23]"}, {"bbox": [15.0, 152.0, 353.0, 208.0], "text": "Step 3: output computation"}, {"bbox": [715.0, 261.0, 932.0, 381.0], "text": "Contribution from previous chunk."}, {"bbox": [685.0, 428.0, 891.0, 488.0], "text": "$$\n\\mathbf {O} _ {[ i + 1 ]} = \\mathbf {Q} _ {[ i + 1 ]} \\mathbf {S} _ {[ i ]}\n$$"}], "63": [{"bbox": [15.0, 32.0, 927.0, 96.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23]"}, {"bbox": [15.0, 152.0, 353.0, 208.0], "text": "Step 3: output computation"}, {"bbox": [715.0, 261.0, 932.0, 381.0], "text": "Contribution from previous chunk."}, {"bbox": [686.0, 427.0, 981.0, 570.0], "text": "$$\n\\begin{array}{l} \\mathbf {O} _ {[ i + 1 ]} = \\mathbf {Q} _ {[ i + 1 ]} \\mathbf {S} _ {[ i ]} \\\\ + \\left(\\left(\\mathbf {Q} _ {[ i + 1 ]} \\mathbf {K} _ {[ i + 1 ]} ^ {\\top}\\right) \\odot \\mathbf {M}\\right) \\mathbf {V} _ {[ i + 1 ]} \\\\ \\end{array}\n$$"}], "64": [{"bbox": [15.0, 27.0, 929.0, 100.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23]"}, {"bbox": [35.0, 180.0, 964.0, 717.0], "text": "<table border=\"1\"><tr><td></td><td>Fully Parallel Form</td><td>Chunkwise Parallel Form</td><td>Fully Recurrent Form</td></tr><tr><td>Compute</td><td>$O(L^{2})$</td><td>$O(LC)$</td><td>$O(L)$</td></tr><tr><td>Memory</td><td>$O(L)$</td><td>$O(C)$</td><td>$O(1)$</td></tr><tr><td>Steps</td><td>$O(1)$</td><td>$O\\left(\\frac{L}{C}\\right)$</td><td>$O(L)$</td></tr></table>"}, {"bbox": [25.0, 764.0, 965.0, 823.0], "text": "Chunkwise parallel form interpolates between fully parallel and recurrent forms."}, {"bbox": [36.0, 826.0, 402.0, 880.0], "text": "C = L $\\rightarrow$ Fully parallel form"}, {"bbox": [37.0, 884.0, 426.0, 943.0], "text": "C=1 $\\rightarrow$ Fully recurrent form"}], "65": [{"bbox": [15.0, 28.0, 929.0, 100.0], "text": "Linear Attention: \"Chunkwise Parallel Form\" [Hua et al. '22, Sun et al. '23]"}, {"bbox": [34.0, 181.0, 965.0, 718.0], "text": "<table border=\"1\"><tr><td></td><td>Fully Parallel Form</td><td>Chunkwise Parallel Form</td><td>Fully Recurrent Form</td></tr><tr><td>Compute</td><td>$O(L^{2})$</td><td>$O(LC)$</td><td>$O(L)$</td></tr><tr><td>Memory</td><td>$O(L)$</td><td>$O(C)$</td><td>$O(1)$</td></tr><tr><td>Steps</td><td>$O(1)$</td><td>$O\\left(\\frac{L}{C}\\right)$</td><td>$O(L)$</td></tr></table>"}, {"bbox": [25.0, 765.0, 965.0, 823.0], "text": "Chunkwise parallel form interpolates between fully parallel and recurrent forms."}, {"bbox": [36.0, 826.0, 402.0, 880.0], "text": "C = L $\\rightarrow$ Fully parallel form"}, {"bbox": [38.0, 884.0, 425.0, 942.0], "text": "C = 1 $\\rightarrow$ Fully recurrent form"}], "66": [{"bbox": [14.0, 32.0, 354.0, 94.0], "text": "## Linear Attention: Issues"}, {"bbox": [32.0, 385.0, 420.0, 623.0], "text": "Issue 1:\n\nSlower than optimized implementations of softmax attention in practice."}], "67": [{"bbox": [12.0, 30.0, 356.0, 96.0], "text": "## Linear Attention: Issues"}, {"bbox": [34.0, 389.0, 380.0, 627.0], "text": "Issue 2:\n\nUnderperforms softmax attention by a significant margin."}, {"bbox": [419.0, 367.0, 951.0, 686.0], "text": "<table border=\"1\"><tr><td>Model</td><td>PPL↓</td><td>LM Eval↑</td></tr><tr><td>Softmax attention</td><td>16.9</td><td>50.9</td></tr><tr><td>Linear attention with decay(RetNet) $ S_{t}=\\gamma S_{t-1}+k_{t}v_{t}^{T}$</td><td>18.6</td><td>48.9</td></tr></table>"}], "68": [{"bbox": [15.0, 30.0, 765.0, 97.0], "text": "## Linear Transformers for Efficient Sequence Modeling"}, {"bbox": [245.0, 245.0, 740.0, 368.0], "text": "## Gated Linear Attention Transformers with Hardware-Efficient Training"}, {"bbox": [256.0, 393.0, 899.0, 488.0], "text": "Songlin Yang $^{*}$ , Bailin Wang $^{*}$ , Yikang Shen,Rameswar Panda, Yoon Kim ICML '24"}, {"bbox": [243.0, 617.0, 739.0, 740.0], "text": "Parallelizing Linear Transformers with the Delta Rule over Sequence Length"}, {"bbox": [254.0, 752.0, 816.0, 845.0], "text": "Songlin Yang, Bailin Wang, Yu Zhang, Yikang Shen, Yoon Kim NeurIPS '24"}], "69": [{"bbox": [14.0, 29.0, 277.0, 96.0], "text": "## Our Contributions"}], "7": [{"bbox": [14.0, 31.0, 395.0, 98.0], "text": "Transformers [Vaswani et al. '17]"}], "70": [{"bbox": [14.0, 29.0, 277.0, 96.0], "text": "## Our Contributions"}], "71": [{"bbox": [14.0, 29.0, 628.0, 96.0], "text": "## Background: Principles of GPU Optimization"}], "72": [{"bbox": [14.0, 30.0, 628.0, 96.0], "text": "## Background: Principles of GPU Optimization"}, {"bbox": [35.0, 785.0, 382.0, 929.0], "text": "Minimize memory movement between global memory (HBM) and L2 cache (kernel fusion)."}], "73": [{"bbox": [14.0, 30.0, 628.0, 96.0], "text": "## Background: Principles of GPU Optimization"}, {"bbox": [35.0, 404.0, 386.0, 503.0], "text": "Keep the streaming multiprocessors as busy as possible (parallelization)."}, {"bbox": [35.0, 786.0, 382.0, 929.0], "text": "Minimize memory movement between global memory (HBM) and L2 cache (kernel fusion)."}], "74": [{"bbox": [15.0, 31.0, 628.0, 96.0], "text": "## Background: Principles of GPU Optimization"}, {"bbox": [39.0, 235.0, 345.0, 332.0], "text": "Use (half-precision) matmuls as much as possible."}, {"bbox": [35.0, 404.0, 386.0, 502.0], "text": "Keep the streaming multiprocessors as busy as possible (parallelization)."}, {"bbox": [36.0, 786.0, 382.0, 929.0], "text": "Minimize memory movement between global memory (HBM) and L2 cache (kernel fusion)."}], "75": [{"bbox": [15.0, 30.0, 638.0, 96.0], "text": "Background: FlashAttention [Dao et al. '22, Dao '23]"}], "76": [{"bbox": [12.0, 30.0, 979.0, 94.0], "text": "## FlashLinearAttention: Hardware-Efficient Algorithm for Linear Attention"}, {"bbox": [29.0, 630.0, 487.0, 687.0], "text": "Step 1: Sequential state computation"}, {"bbox": [29.0, 748.0, 432.0, 921.0], "text": "Fuse local state computation and state passing in a single kernel to minimize I/O cost."}], "77": [{"bbox": [12.0, 30.0, 979.0, 94.0], "text": "## FlashLinearAttention: Hardware-Efficient Algorithm for Linear Attention"}, {"bbox": [28.0, 629.0, 489.0, 686.0], "text": "Step 1: Sequential state computation"}, {"bbox": [28.0, 746.0, 433.0, 922.0], "text": "Fuse local state computation and state passing in a single kernel to minimize I/O cost."}, {"bbox": [540.0, 635.0, 970.0, 693.0], "text": "Step 2: Parallel output computation"}, {"bbox": [539.0, 752.0, 990.0, 928.0], "text": "Compute all chunk outputs in parallel based on previous chunk's state and current chunk's QKV blocks."}], "78": [{"bbox": [12.0, 29.0, 979.0, 94.0], "text": "## FlashLinearAttention: Hardware-Efficient Algorithm for Linear Attention"}], "79": [{"bbox": [443.0, 70.0, 745.0, 122.0], "text": "## Flash Linear Attention"}, {"bbox": [546.0, 177.0, 643.0, 211.0], "text": "## Hub | Discord"}, {"bbox": [200.0, 244.0, 936.0, 319.0], "text": "This repo aims at providing a collection of efficient Triton-based implementations for state-of-the-art linear attention models."}, {"bbox": [38.0, 401.0, 480.0, 973.0], "text": "<table border=\"1\"><tr><td>Date</td><td>Model</td><td>Title</td><td>Paper</td><td>Code</td><td>FLA impl</td></tr><tr><td>2023-07</td><td>RetNet(@MSRA@THU)</td><td>Retentive network:a successor to transformer for large language models</td><td>[arxiv]</td><td>[official][RetNet]</td><td>code</td></tr><tr><td>2023-12</td><td>GLA(@MIT@IBM)</td><td>Gated Linear Attention Transformers with Hardware-Efficient Training</td><td>[arxiv]</td><td>[official]</td><td>code</td></tr><tr><td>2023-12</td><td>Based(@Stanford@Hazyresearch)</td><td>An Educational and Effective Sequence Mixer</td><td>[blog]</td><td>[official]</td><td>code</td></tr><tr><td>2024-01</td><td>Rebased</td><td>Linear Transformers with Learnable Kernel Functions are Better In-Context Models</td><td>[arxiv]</td><td>[official]</td><td>code</td></tr><tr><td>2021-02</td><td>Delta Net</td><td>Linear Transformers Are Secretly Fast Weight Programmers</td><td>[arxiv]</td><td>[official]</td><td>code</td></tr><tr><td>2021-10</td><td>ABC(@UW)</td><td>Attention with Bounded-memory Control</td><td>arxiv</td><td></td><td>code</td></tr><tr><td>2023-09</td><td>HGRN</td><td>Hierarchically Gated Recurrent Neural Network for Sequence Modeling</td><td>openreview</td><td>[official]</td><td>code</td></tr></table>"}, {"bbox": [539.0, 400.0, 980.0, 987.0], "text": "<table border=\"1\"><tr><td>Date</td><td>Model</td><td>Title</td><td>Paper</td><td>Code</td><td>FLA impl</td></tr><tr><td>2023-09</td><td>HGRN</td><td>Hierarchically Gated Recurrent Neural Network for Sequence Modeling</td><td>openreview</td><td>[official]</td><td>code</td></tr><tr><td>2024-04</td><td>HGRN2</td><td>HGRN2: Gated Linear RNNs with State Expansion</td><td>arxiv</td><td>[official]</td><td>code</td></tr><tr><td>2024-04</td><td>RWKV6</td><td>Eagle and Finch: RWKV with Matrix-Valued States and Dynamic Recurrence</td><td>arxiv</td><td>[official]</td><td>code</td></tr><tr><td>2024-06</td><td>Samba</td><td>Samba: Simple Hybrid State Space Models for Efficient Unlimited Context Language Modeling</td><td>arxiv</td><td>[official]</td><td>code</td></tr><tr><td>2024-05</td><td>Mamba2</td><td>Transformers are SSMs: Generalized Models and Efficient Algorithms Through Structured State Space Duality</td><td>arxiv</td><td>[official]</td><td>code</td></tr><tr><td>2024-09</td><td>GSA</td><td>Gated Slot Attention for Efficient Linear-Time Sequence Modeling</td><td>arxiv</td><td>[official]</td><td>code</td></tr></table>"}], "8": [{"bbox": [14.0, 32.0, 395.0, 96.0], "text": "Transformers [Vaswani et al. '17]"}], "80": [{"bbox": [14.0, 30.0, 277.0, 96.0], "text": "## Our Contributions"}], "81": [{"bbox": [15.0, 30.0, 868.0, 98.0], "text": "Gated Linear Attention: Data-dependent Multiplicative Gate"}, {"bbox": [41.0, 149.0, 328.0, 208.0], "text": "Simple Linear Attention"}, {"bbox": [111.0, 314.0, 341.0, 392.0], "text": "$$\n\\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} \\boldsymbol {v} _ {t} ^ {\\top}\n$$"}], "82": [{"bbox": [12.0, 30.0, 868.0, 99.0], "text": "Gated Linear Attention: Data-dependent Multiplicative Gate"}, {"bbox": [495.0, 311.0, 933.0, 743.0], "text": "$$\n\\begin{array}{l} z _ {t} = \\sigma \\left(W _ {z} \\cdot \\left[ h _ {t - 1}, x _ {t} \\right]\\right) \\\\ r _ {t} = \\sigma \\left(W _ {r} \\cdot \\left[ h _ {t - 1}, x _ {t} \\right]\\right) \\\\ \\tilde {h} _ {t} = \\operatorname {t a n h} \\left(W \\cdot \\left[ r _ {t} * h _ {t - 1}, x _ {t} \\right]\\right) \\\\ h _ {t} = \\left(1 - z _ {t}\\right) * h _ {t - 1} + z _ {t} * \\tilde {h} _ {t} \\\\ \\end{array}\n$$"}], "83": [{"bbox": [15.0, 31.0, 868.0, 97.0], "text": "Gated Linear Attention: Data-dependent Multiplicative Gate"}, {"bbox": [41.0, 149.0, 328.0, 208.0], "text": "Simple Linear Attention"}, {"bbox": [110.0, 314.0, 342.0, 392.0], "text": "$$\n\\mathbf {S} _ {t} = \\mathbf {S} _ {t - 1} + k _ {t} v _ {t} ^ {\\top}\n$$"}, {"bbox": [35.0, 553.0, 311.0, 611.0], "text": "Gated Linear Attention"}, {"bbox": [81.0, 705.0, 377.0, 777.0], "text": "$$\n\\mathbf {S} _ {t} = \\mathbf {G} _ {t} \\odot \\mathbf {S} _ {t - 1} + k _ {t} v _ {t} ^ {\\top}\n$$"}, {"bbox": [81.0, 792.0, 501.0, 870.0], "text": "$$\n\\mathbf {G} _ {t} = \\boldsymbol {\\alpha} _ {t} \\mathbf {1}, ^ {\\top} \\quad \\boldsymbol {\\alpha} _ {t} = \\sigma \\left(\\boldsymbol {x} _ {t} \\boldsymbol {W} _ {\\alpha_ {1}} \\boldsymbol {W} _ {\\alpha_ {2}}\\right) ^ {\\frac {1}{\\tau}}\n$$"}], "84": [{"bbox": [14.0, 27.0, 562.0, 97.0], "text": "Gated Linear Attention: Parallel Forms"}, {"bbox": [41.0, 146.0, 328.0, 208.0], "text": "Simple Linear Attention"}, {"bbox": [81.0, 277.0, 339.0, 356.0], "text": "$$\n\\mathbf {O} = \\left(\\left(\\mathbf {Q K} ^ {\\top}\\right) \\odot \\mathbf {M}\\right) \\mathbf {V}\n$$"}, {"bbox": [34.0, 551.0, 312.0, 612.0], "text": "Gated Linear Attention"}, {"bbox": [615.0, 445.0, 978.0, 629.0], "text": "GLA also admits a chunkwise parallel form for subquadratic parallel training!"}, {"bbox": [60.0, 670.0, 942.0, 934.0], "text": "$$\n\\mathbf {O} = \\left(\\left(\\underbrace {\\left(\\mathbf {Q} \\odot \\mathbf {B}\\right) \\left(\\frac {\\mathbf {K}}{\\mathbf {B}}\\right) ^ {\\top}} _ {\\mathbf {P}}\\right) \\odot \\mathbf {M}\\right) \\mathbf {V} \\quad \\begin{array}{l} \\mathbf {B} _ {t}: = \\prod_ {j = 1} ^ {t} \\alpha_ {j} \\\\ \\mathbf {P} _ {i j} = \\sum_ {k = 1} ^ {d} \\mathbf {Q} _ {i k} \\mathbf {K} _ {j k} \\exp (\\log \\mathbf {B} _ {i k} - \\log \\mathbf {B} _ {j k}) \\end{array}\n$$"}], "85": [{"bbox": [12.0, 31.0, 910.0, 95.0], "text": "Gated Linear Attention: Decay-aware Chunkwise Parallel Form"}, {"bbox": [20.0, 151.0, 403.0, 208.0], "text": "Step 1: local state computation"}, {"bbox": [127.0, 341.0, 212.0, 388.0], "text": "Chunk 1"}, {"bbox": [573.0, 110.0, 921.0, 190.0], "text": "$$\n\\Lambda_ {i C + j} = \\frac {\\boldsymbol {b} _ {i C + j}}{\\boldsymbol {b} _ {i C}}, \\Gamma_ {i C + j} = \\frac {\\boldsymbol {b} _ {(i + 1) C}}{\\boldsymbol {b} _ {i C + j}}, \\gamma_ {i + 1} = \\frac {\\boldsymbol {b} _ {(i + 1) C}}{\\boldsymbol {b} _ {i C}},\n$$"}, {"bbox": [445.0, 342.0, 532.0, 388.0], "text": "Chunk 2"}, {"bbox": [577.0, 194.0, 927.0, 248.0], "text": "$$\n\\mathbf {S} _ {[ i + 1 ]} = \\left(\\gamma_ {i + 1} ^ {\\top} \\mathbf {1}\\right) \\odot \\mathbf {S} _ {[ i ]} + \\left(\\mathbf {K} _ {[ i + 1 ]} \\odot \\boldsymbol {\\Gamma} _ {[ i + 1 ]}\\right) ^ {\\top} \\mathbf {V} _ {[ i + 1 ]},\n$$"}, {"bbox": [575.0, 250.0, 784.0, 297.0], "text": "$$\n\\mathbf {O} _ {[ i + 1 ]} ^ {\\mathrm {i n t e r}} = \\left(\\mathbf {Q} _ {[ i + 1 ]} \\odot \\boldsymbol {\\Lambda} _ {[ i + 1 ]}\\right) \\mathbf {S} _ {[ i ]}.\n$$"}, {"bbox": [786.0, 342.0, 873.0, 388.0], "text": "Chunk 3"}], "86": [{"bbox": [12.0, 31.0, 910.0, 96.0], "text": "Gated Linear Attention: Decay-aware Chunkwise Parallel Form"}, {"bbox": [21.0, 151.0, 283.0, 209.0], "text": "Step 2: state passing"}, {"bbox": [573.0, 109.0, 920.0, 189.0], "text": "$$\n\\Lambda_ {i C + j} = \\frac {\\boldsymbol {b} _ {i C + j}}{\\boldsymbol {b} _ {i C}}, \\Gamma_ {i C + j} = \\frac {\\boldsymbol {b} _ {(i + 1) C}}{\\boldsymbol {b} _ {i C + j}}, \\gamma_ {i + 1} = \\frac {\\boldsymbol {b} _ {(i + 1) C}}{\\boldsymbol {b} _ {i C}},\n$$"}, {"bbox": [127.0, 341.0, 213.0, 389.0], "text": "Chunk 1"}, {"bbox": [576.0, 192.0, 927.0, 249.0], "text": "$$\n\\mathbf {S} _ {[ i + 1 ]} = \\left(\\boldsymbol {\\gamma} _ {i + 1} ^ {\\top} \\mathbf {1}\\right) \\odot \\mathbf {S} _ {[ i ]} + \\left(\\mathbf {K} _ {[ i + 1 ]} \\odot \\boldsymbol {\\Gamma} _ {[ i + 1 ]}\\right) ^ {\\top} \\mathbf {V} _ {[ i + 1 ]},\n$$"}, {"bbox": [575.0, 249.0, 785.0, 297.0], "text": "$$\n\\mathbf {O} _ {[ i + 1 ]} ^ {\\mathrm {i n t e r}} = \\left(\\mathbf {Q} _ {[ i + 1 ]} \\odot \\boldsymbol {\\Lambda} _ {[ i + 1 ]}\\right) \\mathbf {S} _ {[ i ]}.\n$$"}, {"bbox": [260.0, 448.0, 297.0, 501.0], "text": "$$\n\\mathbf {S} _ {[ 1 ]}\n$$"}], "87": [{"bbox": [12.0, 31.0, 910.0, 95.0], "text": "Gated Linear Attention: Decay-aware Chunkwise Parallel Form"}, {"bbox": [15.0, 152.0, 353.0, 208.0], "text": "Step 3: output computation"}, {"bbox": [642.0, 118.0, 971.0, 194.0], "text": "$$\n\\Lambda_ {i C + j} = \\frac {\\boldsymbol {b} _ {i C + j}}{\\boldsymbol {b} _ {i C}}, \\Gamma_ {i C + j} = \\frac {\\boldsymbol {b} _ {(i + 1) C}}{\\boldsymbol {b} _ {i C + j}}, \\gamma_ {i + 1} = \\frac {\\boldsymbol {b} _ {(i + 1) C}}{\\boldsymbol {b} _ {i C}},\n$$"}, {"bbox": [645.0, 200.0, 979.0, 249.0], "text": "$$\n\\mathbf {S} _ {[ i + 1 ]} = \\left(\\gamma_ {i + 1} ^ {\\top} \\mathbf {1}\\right) \\odot \\mathbf {S} _ {[ i ]} + \\left(\\mathbf {K} _ {[ i + 1 ]} \\odot \\boldsymbol {\\Gamma} _ {[ i + 1 ]}\\right) ^ {\\top} \\mathbf {V} _ {[ i + 1 ]},\n$$"}, {"bbox": [644.0, 249.0, 845.0, 304.0], "text": "$$\n\\mathbf {O} _ {[ i + 1 ]} ^ {\\mathrm {i n t e r}} = \\left(\\mathbf {Q} _ {[ i + 1 ]} \\odot \\boldsymbol {\\Lambda} _ {[ i + 1 ]}\\right) \\mathbf {S} _ {[ i ]}.\n$$"}, {"bbox": [705.0, 366.0, 920.0, 483.0], "text": "Contribution from previous chunk."}], "88": [{"bbox": [15.0, 32.0, 527.0, 97.0], "text": "## Gated Linear Attention: Throughput"}, {"bbox": [436.0, 178.0, 636.0, 231.0], "text": "Training throughput"}], "9": [{"bbox": [14.0, 32.0, 395.0, 97.0], "text": "Transformers [Vaswani et al. '17]"}]}, "partialPages": [], "sourceSha256": "04d966f1f4eeb46a3105eea78654ef4a630c1b4f35f47fe23030b44e512602e2", "version": 1}