 & 1 \\end{array}\n$$"}, {"bbox": [511.0, 353.0, 595.0, 395.0], "text": "Expert 1"}, {"bbox": [397.0, 443.0, 497.0, 555.0], "text": "x"}, {"bbox": [510.0, 469.0, 600.0, 511.0], "text": "Expert 2"}, {"bbox": [11.0, 731.0, 69.0, 769.0], "text": "DP2"}, {"bbox": [254.0, 607.0, 342.0, 812.0], "text": "43\n\n12\n\n23\n\n13"}, {"bbox": [513.0, 622.0, 600.0, 664.0], "text": "Expert 3"}, {"bbox": [514.0, 738.0, 599.0, 781.0], "text": "Expert 4"}], "33": [{"bbox": [1.0, 20.0, 514.0, 141.0], "text": "## DP + EP"}, {"bbox": [76.0, 258.0, 207.0, 338.0], "text": "Hidden states tokens"}, {"bbox": [0.0, 414.0, 52.0, 456.0], "text": "DP1"}, {"bbox": [233.0, 299.0, 354.0, 341.0], "text": "Expert index"}, {"bbox": [341.0, 200.0, 428.0, 280.0], "text": "Dispatch\n\nAlltoAll"}, {"bbox": [252.0, 347.0, 342.0, 550.0], "text": "$$\n\\begin{array}{c c c c} 1 & 2 \\\\ 2 & 3 \\\\ 2 & 4 \\\\ 3 & 1 \\end{array}\n$$"}, {"bbox": [593.0, 203.0, 669.0, 281.0], "text": "Combine\n\nAlltoAll"}, {"bbox": [509.0, 346.0, 593.0, 388.0], "text": "Expert 1"}, {"bbox": [395.0, 437.0, 492.0, 549.0], "text": "```markdown\n\n```"}, {"bbox": [507.0, 463.0, 597.0, 505.0], "text": "Expert 2"}, {"bbox": [253.0, 600.0, 340.0, 804.0], "text": "43\n\n12\n\n23\n\n13"}, {"bbox": [11.0, 722.0, 69.0, 760.0], "text": "DP2"}, {"bbox": [647.0, 322.0, 714.0, 535.0], "text": "```markdown\n\n```"}, {"bbox": [510.0, 615.0, 596.0, 657.0], "text": "Expert 3"}, {"bbox": [511.0, 730.0, 596.0, 772.0], "text": "Expert 4"}, {"bbox": [650.0, 583.0, 713.0, 795.0], "text": "```markdown\n\n```"}], "34": [{"bbox": [1.0, 19.0, 512.0, 141.0], "text": "## TP → DP + EP"}, {"bbox": [76.0, 259.0, 209.0, 340.0], "text": "Hidden states tokens"}, {"bbox": [0.0, 415.0, 52.0, 456.0], "text": "DP1"}, {"bbox": [233.0, 300.0, 355.0, 344.0], "text": "Expert index"}, {"bbox": [341.0, 200.0, 428.0, 281.0], "text": "Dispatch\n\nAlltoAll"}, {"bbox": [252.0, 347.0, 343.0, 552.0], "text": "$$\n\\begin{array}{c c c c} 1 & 2 \\\\ 2 & 3 \\\\ 2 & 4 \\\\ 3 & 1 \\end{array}\n$$"}, {"bbox": [594.0, 204.0, 670.0, 283.0], "text": "Combine\n\nAlltoAll"}, {"bbox": [509.0, 348.0, 593.0, 389.0], "text": "Expert 1"}, {"bbox": [397.0, 438.0, 495.0, 550.0], "text": "x"}, {"bbox": [508.0, 464.0, 597.0, 508.0], "text": "Expert 2"}, {"bbox": [718.0, 286.0, 851.0, 331.0], "text": "Expert weight"}, {"bbox": [253.0, 601.0, 341.0, 807.0], "text": "43\n\n12\n\n23\n\n13"}, {"bbox": [11.0, 724.0, 69.0, 763.0], "text": "DP2"}, {"bbox": [643.0, 324.0, 714.0, 538.0], "text": "```markdown\n\n```"}, {"bbox": [850.0, 235.0, 992.0, 318.0], "text": "Hidden states /\n\ntokens"}, {"bbox": [741.0, 349.0, 832.0, 537.0], "text": "0.5 0.5\n\n0.8 0.1\n\n..."}, {"bbox": [510.0, 616.0, 597.0, 658.0], "text": "Expert 3"}, {"bbox": [511.0, 731.0, 595.0, 774.0], "text": "Expert 4"}, {"bbox": [650.0, 582.0, 832.0, 795.0], "text": "0.5 0.5\n\n0.8 0.1\n\n..."}], "35": [{"bbox": [9.0, 14.0, 214.0, 328.0], "text": "## layer"}, {"bbox": [623.0, 174.0, 962.0, 310.0], "text": "## all-to-all: distinct chunks to each rank"}], "36": [{"bbox": [7.0, 16.0, 805.0, 144.0], "text": "# Multi-device EP MoE"}], "37": [{"bbox": [7.0, 20.0, 822.0, 158.0], "text": "## MoE scaling behaviour"}, {"bbox": [67.0, 231.0, 772.0, 385.0], "text": "Number of devices decreases compute, increases AlltoAll communication"}, {"bbox": [67.0, 411.0, 680.0, 564.0], "text": "Larger batch size improves throughput, constrains memory"}, {"bbox": [68.0, 590.0, 803.0, 742.0], "text": "- More experts improves parallelization, increases router complexity"}, {"bbox": [68.0, 768.0, 741.0, 922.0], "text": "Redundant experts reduce communication, increase computation"}], "38": [{"bbox": [7.0, 20.0, 859.0, 161.0], "text": "## MoE perf simplifications"}, {"bbox": [69.0, 237.0, 768.0, 318.0], "text": "Uniformly distributed expert routing"}, {"bbox": [68.0, 349.0, 702.0, 428.0], "text": "All experts active in a given step"}, {"bbox": [70.0, 459.0, 613.0, 540.0], "text": "Memory bandwidth bound"}, {"bbox": [70.0, 570.0, 917.0, 651.0], "text": "Ignore link latency: consider only bandwidth"}], "39": [{"bbox": [7.0, 40.0, 956.0, 155.0], "text": "## MoE inference time upper bound"}, {"bbox": [53.0, 207.0, 942.0, 300.0], "text": "## $T_{\\mathrm{MoE}} \\approx T_{\\mathrm{dispatch}}+T_{\\mathrm{experts(grouped GEMM)}}+T_{\\mathrm{combine}}$"}, {"bbox": [58.0, 341.0, 510.0, 936.0], "text": "<table border=\"1\"><tr><td>h</td><td>hidden size</td></tr><tr><td>k</td><td>routed experts per token</td></tr><tr><td>Etot</td><td>total experts</td></tr><tr><td>Egpu</td><td>routed experts on this GPU</td></tr><tr><td>Enode</td><td>routed experts on this node</td></tr><tr><td>Bgpu</td><td>MoE layer input tokens per GPU</td></tr><tr><td>S</td><td>dtype number of bytes</td></tr></table>"}, {"bbox": [591.0, 535.0, 919.0, 620.0], "text": "Grouped GEMM: group of per-expert matrix multiplies with packed tokens"}], "4": [{"bbox": [460.0, 246.0, 540.0, 302.0], "text": "## Mammoth\n\nClusters"}, {"bbox": [473.0, 344.0, 527.0, 400.0], "text": "MAX\n\nFramework"}, {"bbox": [476.0, 489.0, 526.0, 546.0], "text": "Mojo\n\nLanguage"}], "40": [{"bbox": [7.0, 14.0, 771.0, 165.0], "text": "## MoE grouped GEMM"}, {"bbox": [137.0, 232.0, 754.0, 424.0], "text": "$$\nT _ {\\mathrm {H B M}} = \\frac {\\mathrm {B y t e s H B M}}{B W _ {\\mathrm {H B M}}} \\approx \\frac {3 h h ^ {\\prime} E _ {\\mathrm {g p u , a c t i v e}}}{B W _ {\\mathrm {H B M}}}\n$$"}, {"bbox": [10.0, 610.0, 241.0, 972.0], "text": "$h$ hidden size\n\n$k$ routed experts per token\n\n$E_{\\mathrm{tot}}$ total experts\n\n$E_{\\mathrm{gpu}}$ routed experts on this GPU\n\n$E_{\\mathrm{node}}$ routed experts on this node\n\n$B_{\\mathrm{gpu}}$ MoE layer input tokens per GPU\n\n$S$ dtype number of bytes"}, {"bbox": [300.0, 482.0, 921.0, 668.0], "text": "$$\nE _ {\\mathrm {g p u , a c t i v e}} = \\frac {E _ {\\mathrm {r o u t e d}}}{N _ {\\mathrm {g p u}}} + 1 = \\frac {E _ {\\mathrm {t o t a l}}}{8 N _ {\\mathrm {n o d e}}} + 1\n$$"}], "41": [{"bbox": [7.0, 14.0, 489.0, 155.0], "text": "## MoE all-to-all"}, {"bbox": [311.0, 383.0, 722.0, 553.0], "text": "$$\nT _ {\\mathrm {d i s p a t c h , i n t r a}} = \\frac {B _ {\\mathrm {g p u}} k _ {\\mathrm {i n t r a}} h}{B W _ {\\mathrm {N V}}}\n$$"}, {"bbox": [8.0, 612.0, 242.0, 976.0], "text": "$h$ hidden size\n\n$k$ routed experts per token\n\n$E_{\\mathrm{tot}}$ total experts\n\n$E_{\\mathrm{gpu}}$ routed experts on this GPU\n\n$E_{\\mathrm{node}}$ routed experts on this node\n\n$B_{\\mathrm{gpu}}$ MoE layer input tokens per GPU\n\n$S$ dtype number of bytes"}, {"bbox": [312.0, 618.0, 722.0, 794.0], "text": "$$\nT _ {\\mathrm {d i s p a t c h , i n t e r}} = \\frac {B _ {\\mathrm {g p u}} k _ {\\mathrm {i n t e r}} h}{B W _ {\\mathrm {I B}}}\n$$"}], "42": [{"bbox": [7.0, 14.0, 783.0, 165.0], "text": "## MoE node coalescing"}, {"bbox": [65.0, 183.0, 925.0, 419.0], "text": "$$\nn _ {\\mathrm {r e m o t e}} = \\min \\left((N _ {\\mathrm {n o d e}} - 1) \\left[ 1 - \\left(1 - \\frac {1}{N _ {\\mathrm {n o d e}}}\\right) ^ {k} \\right], 4\\right)\n$$"}, {"bbox": [11.0, 612.0, 247.0, 977.0], "text": "$h$ hidden size\n\n$k$ routed experts per token\n\n$E_{\\mathrm{tot}}$ total experts\n\n$E_{\\mathrm{gpu}}$ routed experts on this GPU\n\n$E_{\\mathrm{node}}$ routed experts on this node\n\n$B_{\\mathrm{gpu}}$ MoE layer input tokens per GPU\n\n$S$ dtype number of bytes"}, {"bbox": [320.0, 498.0, 941.0, 693.0], "text": "$$\nT _ {\\mathrm {I B , t o t a l}} = \\frac {B _ {\\mathrm {g p u}} n _ {\\mathrm {r e m o t e}} h \\left(s _ {\\mathrm {d i s p}} + s _ {\\mathrm {c o m b}}\\right)}{B W _ {\\mathrm {I B}}}\n$$"}], "43": [{"bbox": [8.0, 16.0, 577.0, 149.0], "text": "## MoE IB vs. HBM"}, {"bbox": [66.0, 197.0, 134.0, 228.0], "text": "hidden size"}, {"bbox": [66.0, 250.0, 207.0, 283.0], "text": "routed experts per token"}, {"bbox": [18.0, 294.0, 58.0, 339.0], "text": "$$\nE _ {\\mathrm {t o t}}\n$$"}, {"bbox": [66.0, 353.0, 222.0, 388.0], "text": "routed experts on this GPU"}, {"bbox": [14.0, 401.0, 62.0, 444.0], "text": "$$\nE _ {\\mathrm {n o d e}}\n$$"}, {"bbox": [66.0, 408.0, 224.0, 441.0], "text": "routed experts on this node"}, {"bbox": [65.0, 458.0, 248.0, 493.0], "text": "MoE layer input tokens per GPU"}, {"bbox": [66.0, 514.0, 197.0, 546.0], "text": "dtype number of bytes"}, {"bbox": [386.0, 173.0, 955.0, 360.0], "text": "Recall: $E_{\\mathrm{gpu, active}}=\\frac{E_{\\mathrm{total}}}{8 N_{\\mathrm{node}}}+1$"}, {"bbox": [81.0, 653.0, 932.0, 908.0], "text": "$B_{\\mathrm{gpu}}^{*} = \\frac{3 h^{\\prime} E_{gpu, active}}{s_{\\mathrm{disp}} + s_{\\mathrm{comb}}} \\frac{B W_{\\mathrm{IB}}}{B W_{\\mathrm{HBM}}} \\frac{1}{n_{\\mathrm{remote}}}$"}], "44": [{"bbox": [9.0, 20.0, 574.0, 146.0], "text": "## MoE IB vs. HBM"}, {"bbox": [260.0, 281.0, 661.0, 689.0], "text": "$h$ hidden size 2048\n\n$h^{\\prime}$ up-proj hidden size 7168\n\n$k$ routed experts per token 8\n\n$E_{\\mathrm{tot}}$ total experts 256\n\n$BW_{\\mathrm{IB}}$ Infiniband link bandwidth 50GB/s\n\n$BW_{\\mathrm{HBM}}$ HBM link bandwidth 8TB/s"}], "45": [{"bbox": [5.0, 12.0, 189.0, 438.0], "text": "## MoE\n\nIB vs.\n\nHBM"}], "46": [{"bbox": [3.0, 11.0, 190.0, 455.0], "text": "MoE\n\nIB\n\nquant-\n\nization"}], "47": [{"bbox": [4.0, 12.0, 883.0, 159.0], "text": "## Shared experts fusion"}, {"bbox": [116.0, 209.0, 298.0, 291.0], "text": "Recall:"}, {"bbox": [320.0, 164.0, 945.0, 342.0], "text": "$$\nE _ {\\mathrm {g p u , a c t i v e}} = \\frac {E _ {\\mathrm {r o u t e d}}}{N _ {\\mathrm {g p u}}} + 1 = \\frac {E _ {\\mathrm {t o t a l}}}{8 N _ {\\mathrm {n o d e}}} + 1\n$$"}, {"bbox": [116.0, 327.0, 711.0, 412.0], "text": "Optimize the +1 shared expert"}, {"bbox": [115.0, 447.0, 704.0, 528.0], "text": "Treat shared expert as routed"}, {"bbox": [116.0, 564.0, 933.0, 648.0], "text": "Slight increase in all-to-all; limit intra-node"}, {"bbox": [116.0, 683.0, 656.0, 765.0], "text": "Decrease HBM bandwidth"}, {"bbox": [116.0, 803.0, 596.0, 884.0], "text": "Balances expert tokens"}], "48": [{"bbox": [7.0, 22.0, 662.0, 152.0], "text": "## Two batch overlap"}, {"bbox": [114.0, 410.0, 280.0, 467.0], "text": "ATTN: MLA and MoE routing gate SHARED: Shared experts"}, {"bbox": [102.0, 492.0, 464.0, 521.0], "text": "Communication-Computation Overlapping during Prefilling Phase"}, {"bbox": [102.0, 546.0, 845.0, 607.0], "text": "During the decoding phase, the execution durations of different stages are unbalanced. Hence, we subdivide the attention layer into two steps and use a 5-stage pipeline to achieve a seamless communication-computation overlapping."}, {"bbox": [121.0, 790.0, 312.0, 819.0], "text": "micro-batch 0 | micro-batch 1"}, {"bbox": [113.0, 827.0, 568.0, 852.0], "text": "ATTN-0: MLA down/up projection and other ops after combine all-to-all and before core attention"}, {"bbox": [113.0, 857.0, 459.0, 884.0], "text": "ATTN-1: Core attention, attention output projection and MoE routing gate"}, {"bbox": [113.0, 888.0, 241.0, 914.0], "text": "SHARED: Shared experts"}, {"bbox": [103.0, 940.0, 468.0, 968.0], "text": "Communication-Computation Overlapping during Decoding Phase"}], "49": [{"bbox": [7.0, 21.0, 791.0, 165.0], "text": "## Shared expert overlap"}, {"bbox": [16.0, 288.0, 748.0, 365.0], "text": "## Overlap in a single batch is also possible!"}, {"bbox": [344.0, 427.0, 678.0, 456.0], "text": "## Timeline of \"comm\"(skyblue) and \"comp\"(salmon) durations"}], "5": [{"bbox": [555.0, 307.0, 934.0, 748.0], "text": "## 99% of Modular is hardware agnostic"}], "50": [{"bbox": [11.0, 13.0, 770.0, 151.0], "text": "# Expert distributions"}, {"bbox": [423.0, 972.0, 488.0, 993.0], "text": "Expert Index"}, {"bbox": [891.0, 908.0, 970.0, 951.0], "text": "Modular"}], "51": [{"bbox": [8.0, 47.0, 802.0, 160.0], "text": "## Expert parallel load balancing"}, {"bbox": [60.0, 286.0, 615.0, 364.0], "text": "EPLB replicates hot experts"}, {"bbox": [60.0, 399.0, 598.0, 476.0], "text": "Even per-gpu expert loads"}, {"bbox": [60.0, 508.0, 763.0, 588.0], "text": "Mapping based on routing statistics"}, {"bbox": [60.0, 620.0, 780.0, 700.0], "text": "Static EPLB: pre-computed mapping"}, {"bbox": [60.0, 730.0, 892.0, 811.0], "text": "Dynamic EPLB: periodic online rebalancing"}], "52": [{"bbox": [12.0, 48.0, 797.0, 158.0], "text": "## Expert parallel load balancing"}, {"bbox": [41.0, 372.0, 211.0, 404.0], "text": "## workloads of experts"}, {"bbox": [50.0, 431.0, 132.0, 598.0], "text": "expert0: 90\n\nexpert1: 132\n\nexpert2: 40\n\nexpert3: 61\n\nexpert4: 104\n\nexpert5: 165"}, {"bbox": [557.0, 241.0, 802.0, 276.0], "text": "## step1: inter-node balance"}, {"bbox": [145.0, 427.0, 229.0, 596.0], "text": "expert6:39\n\nexpert7:4\n\nexpert8:73\n\nexpert9:56\n\nexpert10:183\n\nexpert11:86"}, {"bbox": [282.0, 397.0, 352.0, 454.0], "text": "Allocate Resources"}, {"bbox": [578.0, 421.0, 784.0, 455.0], "text": "## step2: expert balance"}, {"bbox": [562.0, 588.0, 808.0, 622.0], "text": "## step3: intra-node balance"}], "53": [{"bbox": [8.0, 20.0, 812.0, 152.0], "text": "# Disaggregated inference"}], "54": [{"bbox": [4.0, 16.0, 582.0, 149.0], "text": "## When is DI good?"}, {"bbox": [21.0, 214.0, 308.0, 360.0], "text": "Prefill heavy:\n\nISL >> OSL"}, {"bbox": [18.0, 474.0, 332.0, 769.0], "text": "Large models:\n\nmodel search\n\nspace over\n\nTP, EP, CP, PP"}], "55": [{"bbox": [551.0, 255.0, 680.0, 316.0], "text": "## Modular"}, {"bbox": [551.0, 337.0, 704.0, 378.0], "text": "Inference platform"}, {"bbox": [552.0, 444.0, 664.0, 502.0], "text": "Cluster"}, {"bbox": [552.0, 570.0, 724.0, 632.0], "text": "Framework"}, {"bbox": [552.0, 704.0, 703.0, 764.0], "text": "Language"}], "56": [{"bbox": [551.0, 128.0, 680.0, 188.0], "text": "## Modular"}, {"bbox": [551.0, 209.0, 704.0, 250.0], "text": "Inference platform"}, {"bbox": [552.0, 276.0, 708.0, 337.0], "text": "## Mammoth"}, {"bbox": [550.0, 356.0, 854.0, 477.0], "text": "Deploy large-scale distributed GenAI services with SOTA perf across diverse models & hardware"}, {"bbox": [552.0, 496.0, 702.0, 531.0], "text": "KUBERNETES NATIVE"}, {"bbox": [552.0, 586.0, 723.0, 647.0], "text": "Framework"}, {"bbox": [553.0, 705.0, 703.0, 764.0], "text": "Language"}], "57": [{"bbox": [230.0, 489.0, 306.0, 545.0], "text": "Language\n\nMojo"}, {"bbox": [551.0, 128.0, 681.0, 187.0], "text": "## Modular"}, {"bbox": [551.0, 209.0, 701.0, 249.0], "text": "Inference solution"}, {"bbox": [550.0, 392.0, 690.0, 466.0], "text": "## MAX"}, {"bbox": [551.0, 293.0, 665.0, 352.0], "text": "Cluster"}, {"bbox": [549.0, 478.0, 841.0, 601.0], "text": "Serve 500+ models with SOTA Perf Across GPU (NVIDIA, AMD) & CPU with one container & OpenAI API"}, {"bbox": [554.0, 697.0, 703.0, 754.0], "text": "Language"}, {"bbox": [551.0, 615.0, 764.0, 653.0], "text": "SERVE | ENGINE | KERNELS"}], "58": [{"bbox": [548.0, 184.0, 709.0, 251.0], "text": "Mammoth"}, {"bbox": [551.0, 292.0, 724.0, 355.0], "text": "Framework"}, {"bbox": [549.0, 390.0, 673.0, 465.0], "text": "## Mojo 🔥"}, {"bbox": [549.0, 480.0, 917.0, 605.0], "text": "Invent novel AI algorithms with one,pythonic systems language that runs across any AI hardware with cutting-edge tooling"}, {"bbox": [548.0, 619.0, 779.0, 657.0], "text": "STD LIB | COMPILER | TOOLS"}], "59": [], "6": [{"bbox": [8.0, 11.0, 606.0, 160.0], "text": "## Perf terminology"}, {"bbox": [62.0, 220.0, 624.0, 344.0], "text": "- FLOPs: floating point operations\n\nMath"}, {"bbox": [106.0, 383.0, 652.0, 568.0], "text": "$T_{\\mathrm{math}}=\\frac{\\mathrm{Computation FLOPs}} {\\mathrm{Accelerator FLOPs / s}}$"}, {"bbox": [65.0, 636.0, 382.0, 703.0], "text": "Communication"}, {"bbox": [387.0, 716.0, 750.0, 790.0], "text": "Communication bytes"}, {"bbox": [262.0, 807.0, 875.0, 885.0], "text": "Network/memory bandwidth bytes/s"}], "60": [{"bbox": [49.0, 86.0, 505.0, 168.0], "text": "## Mojo vs. Python eDSLs"}, {"bbox": [46.0, 179.0, 716.0, 263.0], "text": "Python eDSLs focus on prototyping - when dev velocity is more important than performance See Democratizing AI Compute Part #7"}, {"bbox": [49.0, 345.0, 233.0, 396.0], "text": "Mojo's Benefits:"}, {"bbox": [49.0, 417.0, 506.0, 516.0], "text": "Performance/TCO: great for inference and other uses that require max performance"}, {"bbox": [48.0, 572.0, 491.0, 668.0], "text": "Generality: not all kernels are matmul and attention"}, {"bbox": [49.0, 700.0, 420.0, 799.0], "text": "Metaprogramming: you can write reusable generic algorithms"}, {"bbox": [551.0, 413.0, 947.0, 514.0], "text": "Extensible (with APIs/dunders) - not blocked on compiler changes"}, {"bbox": [551.0, 560.0, 970.0, 659.0], "text": "HW Control: arch-specific features like TMAs, asms and intrinsics"}, {"bbox": [551.0, 710.0, 945.0, 809.0], "text": "Tools: Debuggers and profilers work naturally, don't have to stare at IR"}], "61": [{"bbox": [48.0, 86.0, 504.0, 170.0], "text": "## Mojo vs. Python eDSLs"}, {"bbox": [50.0, 402.0, 265.0, 452.0], "text": "Mojo's Downsides:"}, {"bbox": [50.0, 501.0, 494.0, 550.0], "text": "Maturity and established community size"}], "62": [{"bbox": [27.0, 27.0, 939.0, 155.0], "text": "# Mojo GEMM case study by Meta"}, {"bbox": [174.0, 156.0, 752.0, 258.0], "text": "Case study: Benchmarking GEMM on NVIDIA B200 Triton vs. cuBLAS, PT2-CUTLASS, TileLang, and Mojo"}, {"bbox": [174.0, 275.0, 457.0, 313.0], "text": "Single-command to run the benchmark"}, {"bbox": [195.0, 305.0, 655.0, 383.0], "text": "$ python run.py --op gemm --only aten_matmul,mojo_matmul,tilelang, triton_blackwell_warpspec_descriptor_matmul"}, {"bbox": [208.0, 399.0, 440.0, 439.0], "text": "BF16 GEMM TFLOPS on Blackwell"}, {"bbox": [174.0, 860.0, 717.0, 918.0], "text": "Best-effort of configuring all backends in TritonBench. Feedbacks are welcome!"}, {"bbox": [174.0, 901.0, 612.0, 954.0], "text": "Accuracy tests pass for all kernels, using cublas as the baseline."}, {"bbox": [175.0, 928.0, 742.0, 990.0], "text": "$\\checkmark$ Accuracy tests pass for all kernels, using cubes as the base\n\n$\\checkmark$ Advanced features like warp specialization and TMA are enabled on Triton Blackwell"}], "63": [{"bbox": [47.0, 54.0, 496.0, 174.0], "text": "## Mojo at a glance"}, {"bbox": [46.0, 259.0, 461.0, 384.0], "text": "Pythonic system programming language\n\nFull toolchain + VS Code + LSP support"}, {"bbox": [46.0, 458.0, 472.0, 585.0], "text": "Freely available on Linux, Mac and WSL\n\nProgressively open sourcing it as Apache 2"}, {"bbox": [45.0, 619.0, 471.0, 743.0], "text": "A growing and vibrant community\n\n200K+ users overall, >20K users on Discord"}, {"bbox": [571.0, 118.0, 978.0, 604.0], "text": "```python\n\ndef mandelbrot_kernel[\n\n    width: Int  # SIMD Width\n\n] (c: ComplexSIMD[float, width]) -> \n\n    SIMD[int, width]:\n\n    \"\"\"A vectorized implementation of\n\n    the inner mandelbrot\n\ncomputation.\"\"\"\n\n    z = ComplexSIMD[float, width](0,\n\n0)\n\n```"}, {"bbox": [604.0, 895.0, 989.0, 992.0], "text": "for i in range(MAX_ITERS):\n\n    if not any(mask): Modular"}], "64": [], "65": [{"bbox": [20.0, 140.0, 439.0, 221.0], "text": "## Graph Compiler Overview"}, {"bbox": [18.0, 243.0, 201.0, 417.0], "text": "Inputs and outputs\n\nRMO/MO\n\nMOGG\n\nMGP"}, {"bbox": [21.0, 450.0, 132.0, 500.0], "text": "Inputs:"}, {"bbox": [50.0, 515.0, 462.0, 636.0], "text": "MLIR DAG of DL ops (built using a Python Graph API)"}, {"bbox": [52.0, 648.0, 271.0, 701.0], "text": "Package kernels"}, {"bbox": [20.0, 714.0, 464.0, 903.0], "text": "Output: DAG of executable kernels in the Modular Executable Format (MEF)."}], "66": [{"bbox": [19.0, 140.0, 439.0, 221.0], "text": "## Graph Compiler Overview"}, {"bbox": [12.0, 225.0, 470.0, 964.0], "text": "Inputs and outputs\n\nRMO/MO\n\nMOGG\n\nMGP\n\n• (Relaxed) Modular Operators\n\n• RISC-like, only 135 operators\n\n• Vertices = operators, edges = tensors\n\n• Side effects through chains and mutable tensors\n\n• Optimizations:\n\n  • Symbolic folding\n\n  • Shape inference\n\n  • Constant folding"}, {"bbox": [516.0, 182.0, 998.0, 788.0], "text": "```javascript\n\nmo.graph @model<N, M, K>(\n\n%A: !mo.tensor<[M, K], f32>,\n\n%B: !mo.tensor<[K, N], f32, {layout = #mo.layout<KN>}},\n\n%bias: !mo.tensor<[], f32>\n\n) -> (!mo.tensor<[M, N], f32>) {\n\n%C = mo.matmul(%A, %B) : (\n\n    !mo.tensor<[M, K], f32>,\n\n    !mo.tensor<[K, N], f32, {layout = #mo.layout<KN>}>\n\n) -> !mo.tensor<[M, N], f32>\n\n%bcast_bias = mo.static.broadcast_to(%bias)\n\n    : !mo.tensor<[], f32> -> !mo.tensor<[M, N], f32>\n\n%add = mo.add(%C, %bcast_bias) : !mo.tensor<[M, N], f32>\n\n%out = mo.relu(%add) : !mo.tensor<[M, N], f32>\n\nmo.output %out : !mo.tensor<[M, N], f32>\n\n}\n\n```"}], "67": [{"bbox": [551.0, 128.0, 680.0, 188.0], "text": "## Modular"}, {"bbox": [551.0, 209.0, 704.0, 250.0], "text": "Inference platform"}, {"bbox": [552.0, 276.0, 708.0, 337.0], "text": "## Mammoth"}, {"bbox": [550.0, 356.0, 854.0, 477.0], "text": "Deploy large-scale distributed GenAI services with SOTA perf across diverse models & hardware"}, {"bbox": [552.0, 496.0, 702.0, 531.0], "text": "KUBERNETES NATIVE"}, {"bbox": [552.0, 586.0, 723.0, 647.0], "text": "Framework"}, {"bbox": [553.0, 705.0, 703.0, 764.0], "text": "Language"}], "68": [{"bbox": [165.0, 92.0, 827.0, 276.0], "text": "## GenAI Inference is a dynamic, whole stack, distributed compute problem"}], "69": [{"bbox": [13.0, 231.0, 181.0, 376.0], "text": "## Response"}, {"bbox": [281.0, 233.0, 482.0, 344.0], "text": "Modular Router\n\nKVCache-Aware Routing with specialized KV Cache"}, {"bbox": [280.0, 444.0, 486.0, 490.0], "text": "## Disaggregated Serving"}, {"bbox": [255.0, 584.0, 347.0, 621.0], "text": "Prefill Engine"}, {"bbox": [401.0, 526.0, 537.0, 559.0], "text": "Decode Worker (MAX)"}, {"bbox": [267.0, 668.0, 332.0, 737.0], "text": "KVCache\n\nAgent"}, {"bbox": [411.0, 584.0, 517.0, 621.0], "text": "Decode Engine"}, {"bbox": [428.0, 668.0, 493.0, 737.0], "text": "KVCache\n\nAgent"}, {"bbox": [681.0, 244.0, 808.0, 284.0], "text": "## Control Plane"}, {"bbox": [678.0, 301.0, 816.0, 369.0], "text": "Model Management\n\nModel Scaling"}, {"bbox": [707.0, 500.0, 777.0, 532.0], "text": "Controller"}, {"bbox": [706.0, 612.0, 778.0, 643.0], "text": "Scheduler"}, {"bbox": [709.0, 722.0, 777.0, 756.0], "text": "Optimizer"}], "7": [{"bbox": [8.0, 11.0, 409.0, 154.0], "text": "## Perf primer"}, {"bbox": [37.0, 196.0, 948.0, 290.0], "text": "Lower and upper bound inference time"}, {"bbox": [89.0, 348.0, 807.0, 483.0], "text": "$T_{\\mathrm{lower}}=\\max \\left( T_{\\mathrm{math}}, T_{\\mathrm{comms}} \\right)$"}, {"bbox": [84.0, 572.0, 815.0, 723.0], "text": "$T_{\\mathrm{upper}}=T_{\\mathrm{math}}+T_{\\mathrm{comms}}$"}], "70": [{"bbox": [213.0, 96.0, 262.0, 137.0], "text": "MAX"}, {"bbox": [169.0, 207.0, 300.0, 248.0], "text": "Client API"}, {"bbox": [100.0, 341.0, 370.0, 384.0], "text": "Scheduling & Batching"}, {"bbox": [149.0, 476.0, 320.0, 519.0], "text": "Model Library"}, {"bbox": [131.0, 611.0, 339.0, 652.0], "text": "Compiler/Runtime"}, {"bbox": [542.0, 160.0, 744.0, 204.0], "text": "OpenAI API compatible"}, {"bbox": [188.0, 747.0, 282.0, 784.0], "text": "Kernels"}, {"bbox": [538.0, 245.0, 935.0, 411.0], "text": "Agentic Serving Optimizations: Continuous batching, speculative decoding, automatic prefix caching, paged attention, function calling, structured outputs, etc."}, {"bbox": [533.0, 420.0, 924.0, 541.0], "text": "Multimodal, Large Models: Support for text, image, and audio use cases; early large (multi-GPU) model support"}, {"bbox": [522.0, 548.0, 929.0, 711.0], "text": "HW-Agnostic Model Optimizations: Kernel Fusion, Dynamic Shape Support, Quantization Support (BF16, FP8), Tensor/Data/Expert Parallelism, LoRA"}, {"bbox": [466.0, 720.0, 918.0, 887.0], "text": "SOTA & Portable Kernels: All kernels written in Mojo, which can be compiled to multiple CPU and GPU targets (NVIDIA, AMD, Intel, ARM, etc.) — easy to add custom ops"}], "71": [{"bbox": [48.0, 122.0, 324.0, 213.0], "text": "## MAX Serving"}, {"bbox": [50.0, 261.0, 768.0, 337.0], "text": "## A single container that works across hardware"}, {"bbox": [217.0, 417.0, 361.0, 457.0], "text": "MAX CONTAINER"}, {"bbox": [163.0, 500.0, 230.0, 552.0], "text": "MAX"}, {"bbox": [130.0, 594.0, 262.0, 629.0], "text": "SERVING LIBRARY"}, {"bbox": [126.0, 680.0, 268.0, 715.0], "text": "INFERENCE ENGINE"}, {"bbox": [365.0, 507.0, 466.0, 544.0], "text": "LLAMA MODEL"}, {"bbox": [110.0, 817.0, 210.0, 855.0], "text": "H100 GPU"}, {"bbox": [347.0, 817.0, 461.0, 855.0], "text": "MI300X GPU"}, {"bbox": [597.0, 436.0, 924.0, 519.0], "text": "MAX container: ~0.5 GB (NVIDIA only)\n\nvLLM container: ~10 GB (NVIDIA only)"}, {"bbox": [546.0, 599.0, 757.0, 635.0], "text": "Llama405B startup-time:"}, {"bbox": [546.0, 637.0, 855.0, 675.0], "text": "MAX : 2 Minutes (NVIDIA & AMD)"}, {"bbox": [546.0, 677.0, 723.0, 712.0], "text": "vLLM: 7+ minutes"}], "72": [{"bbox": [294.0, 224.0, 703.0, 543.0], "text": "## Thank you!\n\nQ&A"}, {"bbox": [392.0, 769.0, 612.0, 952.0], "text": "Modular"}, {"bbox": [842.0, 912.0, 973.0, 950.0], "text": "BRENDAN DUKE"}], "73": [{"bbox": [303.0, 258.0, 694.0, 518.0], "text": "## brendan Duke\n\nbduke@modular.com\n\ngithub.com/dukebw"}, {"bbox": [391.0, 770.0, 612.0, 952.0], "text": "## Modular"}, {"bbox": [842.0, 912.0, 973.0, 950.0], "text": "BRENDAN DUKE"}], "8": [{"bbox": [8.0, 10.0, 605.0, 161.0], "text": "## Perf terminology"}, {"bbox": [65.0, 220.0, 385.0, 292.0], "text": "Compute bound"}, {"bbox": [111.0, 330.0, 435.0, 433.0], "text": "Tmath > Tcomms"}, {"bbox": [65.0, 516.0, 496.0, 587.0], "text": "communication bound"}, {"bbox": [111.0, 624.0, 434.0, 728.0], "text": "$T_{\\mathrm{comms}} > T_{\\mathrm{math}}$"}], "9": [{"bbox": [47.0, 239.0, 969.0, 312.0], "text": "## How to determine compute vs. communication bound?"}]}, "partialPages": [], "sourceSha256": "7f8e536d9a5bb91c8fafaf959dffd65ca0738692a6c05607aeb4b8253fa85da6", "version": 1}