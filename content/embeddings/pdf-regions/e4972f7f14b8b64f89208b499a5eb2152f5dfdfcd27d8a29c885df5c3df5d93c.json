</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr></table>"}], "12": [{"bbox": [24.0, 51.0, 458.0, 108.0], "text": "## Tensix Core - Data Movement"}, {"bbox": [93.0, 188.0, 326.0, 223.0], "text": "2 data movement kernels"}, {"bbox": [93.0, 229.0, 356.0, 264.0], "text": "- Asynchronous reads & writes"}, {"bbox": [92.0, 268.0, 398.0, 303.0], "text": "Access to all SRAM & DRAM banks"}, {"bbox": [93.0, 310.0, 255.0, 344.0], "text": "Memory barriers"}, {"bbox": [92.0, 348.0, 285.0, 384.0], "text": "- Atomic semaphores"}, {"bbox": [591.0, 332.0, 996.0, 400.0], "text": "<table border=\"1\"><tr><td>Argument</td><td>Description</td><td>Type</td><td>Valid Range</td><td>Required</td></tr><tr><td>addr</td><td>Encoding of the destination location(x,y)+address</td><td>uint64_t</td><td>DOX-TODO(insert a reference to what constitutes valid coords)</td><td>True</td></tr><tr><td>incr</td><td>The value to increment by</td><td>uint32_t</td><td>Any uint32_t value</td><td>True</td></tr></table>"}], "13": [{"bbox": [24.0, 50.0, 459.0, 109.0], "text": "## Tensix Core-Data Movement"}, {"bbox": [41.0, 296.0, 377.0, 738.0], "text": "<table border=\"1\"><tr><td>Feature</td><td>Spec</td></tr><tr><td>Independent NoCs</td><td>2</td></tr><tr><td>NoC type</td><td>2-dimensional torus</td></tr><tr><td></td><td></td></tr><tr><td>NoC link width</td><td>64 Bytes</td></tr><tr><td>NoC link BW</td><td>83 GB/s</td></tr><tr><td></td><td></td></tr><tr><td>Tensix -&gt; NoC I/O BW</td><td>665 GB/s</td></tr><tr><td>SRAM&lt;-&gt; NoCs</td><td>333 GB/s</td></tr><tr><td></td><td></td></tr><tr><td>SRAM&lt;-&gt; NoC aggregate BW</td><td>47 TB/s</td></tr></table>"}], "14": [{"bbox": [26.0, 50.0, 697.0, 108.0], "text": "## Blackhole: Built for AI Data Movement Patterns"}, {"bbox": [28.0, 236.0, 691.0, 313.0], "text": "- Data patterns in MatMuls, Convolutions, and Sharded Data Layouts are regular.\n\n- They have a great mapping to Mesh Architecture"}, {"bbox": [26.0, 393.0, 386.0, 712.0], "text": "<table border=\"1\"><tr><td>Memory&amp;I/O</td><td>Data Movement Pattern</td><td>Bandwidth</td></tr><tr><td>SRAM</td><td>Local/Sharded</td><td>94TB/s</td></tr><tr><td>SRAM</td><td>Neighbor(Halo)</td><td>47TB/s</td></tr><tr><td>SRAM</td><td>Row/Column/MeshMulticast</td><td>24TB/s</td></tr><tr><td>SRAM</td><td>Gather/Scatter(3hops)</td><td>16TB/s</td></tr><tr><td>SRAM</td><td>Gather/Scatter(10hops)</td><td>5TB/s</td></tr><tr><td>DRAM</td><td>Row</td><td>512GB/s</td></tr><tr><td>Ethernet</td><td>Column</td><td>1TB/s</td></tr></table>"}, {"bbox": [450.0, 331.0, 965.0, 966.0], "text": "<table border=\"1\"><tr><td>D</td><td></td><td>P</td><td></td><td></td><td></td><td>D</td><td></td><td></td><td></td><td></td><td></td><td>A</td></tr><tr><td>D</td><td>E</td><td>E</td><td>E</td><td>E</td><td>E</td><td>D</td><td>E</td><td>E</td><td>E</td><td>E</td><td>E</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><td></td><td>T</td><td>T</td><td>D</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>CPU</td></tr><tr><td>D</td><td>T</td><td>T</td><