    {
      "id": "386f8dd68b2c1bdc",
      "type": "text",
      "text": "# français québécois\n\nÉpisodes de Par ici, repères de langue et notes de cours. Chaque carte ouvre sa note.",
      "x": 0,
      "y": 0,
      "width": 960,
      "height": 220
    },
    {
      "id": "97563f00c5816008",
      "type": "file",
