summaries:
  missing: values.filter(value.isType("null")).length
  watched: values.filter(value == "finished").length
filters:
  or:
    - file.hasTag("movies")
    - and:
        - file.inFolder("movies")
        - not:
            - file.hasTag("evergreen", "meta")
        - not:
            - file.inFolder("movies/posters")
formulas:
  primary_studio: list(note.studio)[0]
properties:
  file.tags:
    displayName: tags
  note.director:
    displayName: director
  note.year:
    displayName: year
  note.rating:
    displayName: rating
  note.notes:
    displayName: notes
  note.category:
    displayName: category
  note.studio:
    displayName: production company
  formula.primary_studio:
    displayName: main production company
  note.runtime:
    displayName: runtime
  note.watched:
    displayName: watched date
views:
  - type: vault
    name: vault
    order:
      - category
      - tags
    sort:
      - property: year
        direction: ASC
      - property: title
        direction: ASC
    image: note.posters
    labelTitle: note.title
    labelDirector: note.director
    labelYear: note.year
    labelRating: note.rating
    labelStatus: note.status
    labelStudio: note.studio
    rackMaterial: rack-steel
    bayWidth: 1200
    shelfRows: 5
    dividers: 8
    eraCuts:
      - 1980
      - 2016
  - type: vault
    name: directors
    groupBy:
      property: director
      direction: ASC
    order:
      - category
      - tags
    sort:
      - property: year
        direction: ASC
      - property: title
        direction: ASC
    image: note.posters
    labelTitle: note.title
    labelDirector: note.director
    labelYear: note.year
    labelRating: note.rating
    labelStatus: note.status
    labelStudio: note.studio
    rackMaterial: rack-steel
    bayWidth: 1200
    shelfRows: 5
    dividers: 8
    eraCuts:
      - 1980
      - 2016
  - type: cards
    name: gallery
    groupBy:
      property: year
      direction: DESC
    order:
      - title
      - director
      - rating
      - year
    sort:
      - property: year
        direction: DESC
      - property: rating
        direction: DESC
      - property: watched
        direction: DESC
      - property: title
        direction: ASC
    cardSize: 320
    image: note.posters
  - type: table
    name: to watch
    filters:
      or:
        - status == "to watch"
        - watched.isEmpty()
    groupBy:
      property: year
      direction: DESC
    order:
      - title
      - year
      - director
      - category
      - studio
      - file.tags
    sort:
      - property: year
        direction: DESC
      - property: title
        direction: ASC
    columnSize:
      note.title: 350
      note.year: 100
      note.director: 200
  - type: table
    name: finished
    filters:
      and:
        - status == "finished"
    groupBy:
      property: year
      direction: DESC
    order:
      - title
      - year
      - director
      - rating
      - watched
      - category
      - notes
    sort:
      - property: watched
        direction: DESC
      - property: rating
        direction: DESC
      - property: title
        direction: ASC
    columnSize:
      note.title: 350
      note.year: 100
      note.director: 200
      note.rating: 100
  - type: table
    name: by director
    groupBy:
      property: director
      direction: ASC
    order:
      - title
      - year
      - director
      - rating
      - category
      - watched
    sort:
      - property: director
        direction: ASC
      - property: year
        direction: DESC
    columnSize:
      note.title: 350
      note.year: 100
      note.rating: 100
  - type: table
    name: vintage
    filters:
      and:
        - category == "vintage"
    groupBy:
      property: year
      direction: ASC
    order:
      - title
      - year
      - director
      - rating
      - status
    sort:
      - property: year
        direction: ASC
      - property: title
        direction: ASC
    columnSize:
      note.title: 350
      note.year: 100
      note.director: 200
  - type: table
    name: by studio
    groupBy:
      property: studio
      direction: ASC
    order:
      - title
      - year
      - director
      - rating
      - status
      - watched
    sort:
      - property: studio
        direction: ASC
      - property: year
        direction: DESC
    columnSize:
      note.title: 350
      note.year: 100
      note.director: 200
  - type: table
    name: highly rated
    filters:
      and:
        - rating >= 8
        - status == "finished"
    groupBy:
      property: rating
      direction: DESC
    order:
      - title
      - rating
      - year
      - director
      - category
      - watched
    sort:
      - property: rating
        direction: DESC
      - property: year
        direction: DESC
    columnSize:
      note.title: 350
      note.rating: 100
      note.director: 200
  - type: list
    name: quick list
    groupBy:
      property: category
      direction: ASC
    order:
      - title
      - director
      - year
    sort:
      - property: title
        direction: ASC
      - property: year
        direction: DESC
      - property: status
        direction: ASC
    nestedProperties: true
  - type: table
    name: editors
    groupBy:
      property: year
      direction: DESC
    order:
      - title
      - director
      - status
      - studio
      - tags
      - watched
      - year
      - rating
      - category
      - posters
      - description
    sort:
      - property: watched
        direction: ASC
      - property: status
        direction: DESC
      - property: rating
        direction: DESC
      - property: tags
        direction: DESC
      - property: title
        direction: ASC
    columnSize: {}
  - type: kanban
    name: analysis
    filters:
      and:
        - "!studio.isEmpty()"
        - year > 2000
    groupBy:
      property: formula.primary_studio
      direction: ASC
    order:
      - title
      - rating
      - tags
    sort:
      - property: rating
        direction: DESC
      - property: title
        direction: ASC
    columnWidth: 280
    imageAspectRatio: 1.7777777778
    image: note.posters
