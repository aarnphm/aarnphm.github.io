{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "provider": { "type": "string", "const": "mywindsock" },
    "activity": {
      "type": "object",
      "properties": {
        "stravaId": { "type": "string", "pattern": "^[1-9]\\d*$" },
        "sport": { "type": "string", "enum": ["run", "bike"] },
        "stravaSportType": { "type": "string" },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "stravaBaseline": {
          "type": "object",
          "properties": {
            "distanceM": { "type": "number", "minimum": 0 },
            "movingTimeS": { "type": "number", "minimum": 0 },
            "elapsedTimeS": { "type": "number", "minimum": 0 },
            "elevationGainM": { "type": ["number", "null"] }
          },
          "required": ["distanceM", "movingTimeS", "elapsedTimeS", "elevationGainM"],
          "additionalProperties": false
        }
      },
      "required": [
        "stravaId",
        "sport",
        "stravaSportType",
        "startedAt",
        "localDate",
        "stravaBaseline"
      ],
      "additionalProperties": false
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "stravaUrl": { "type": "string", "format": "uri" },
        "myWindsockUrl": { "type": "string", "format": "uri" },
        "providerCourseId": {
          "anyOf": [{ "type": "string", "pattern": "^[1-9]\\d*$" }, { "type": "null" }]
        }
      },
      "required": ["stravaUrl", "myWindsockUrl", "providerCourseId"],
      "additionalProperties": false
    },
    "ingestion": {
      "type": "object",
      "properties": {
        "state": { "type": "string", "enum": ["summary-only", "captured", "ready"] },
        "pending": { "type": "array", "items": { "type": "string" } },
        "sections": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": "string",
            "enum": ["captured", "not-captured", "unavailable"]
