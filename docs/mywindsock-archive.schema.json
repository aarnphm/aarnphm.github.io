              "required": [
                "source",
                "transport",
                "schemaVersion",
                "activityId",
                "retrievedAt",
                "provider",
                "weatherImpactPct",
                "cdaM2",
                "feelsLikeElevationM",
                "headwindPct",
                "headwindMinKph",
                "headwindMaxKph",
                "longestHeadwindS",
                "airSpeedKph",
                "averageTemperatureC",
                "precipitationProbabilityPct",
                "precipitationRateMmPerHour"
              ],
              "additionalProperties": false
            }
          },
          "required": ["rawReport", "parsed"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
