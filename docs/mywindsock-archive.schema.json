              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "pageUrl": { "type": "string", "format": "uri" },
            "stravaId": { "type": "string", "pattern": "^[1-9]\\d*$" },
            "viewOnStravaId": { "type": "string", "pattern": "^[1-9]\\d*$" },
            "providerCourseId": { "type": "string", "pattern": "^[1-9]\\d*$" },
            "providerStravaId": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "rideTimestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "pageType": { "type": "string", "const": "activity" },
            "pageMode": { "type": "string", "const": "analyst" },
            "runtime": {
              "type": "object",
              "properties": {
