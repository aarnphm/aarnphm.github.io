              },
              "status": {
                "type": "string",
                "enum": ["success", "partial", "unavailable", "failed"]
              },
              "note": { "type": "string" }
            },
            "required": ["at", "status", "note"],
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "description-import",
                  "browser-import",
                  "graph-import",
                  "manual-edit",
                  "verify"
                ]
              },
              "note": { "type": "string" },
              "captureSha256": {
                "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
              }
            },
            "required": ["at", "type", "note", "captureSha256"],
            "additionalProperties": false
          }
        },
        "captureSha256": {
          "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
        },
        "graphsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["state", "pending", "sections", "attempts", "events", "captureSha256"],
      "additionalProperties": false
    },
    "description": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rawReport": { "type": "string" },
            "parsed": {
              "type": "object",
              "properties": {
                "source": { "type": "string", "const": "provider-native" },
                "transport": { "type": "string", "const": "strava-description" },
                "schemaVersion": { "type": "number", "const": 1 },
                "activityId": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
