                      "title": { "type": "string" },
                      "series": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": { "type": ["string", "null"] },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "array",
                                "prefixItems": [
