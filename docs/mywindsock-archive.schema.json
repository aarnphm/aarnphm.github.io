                  "weight": { "type": ["string", "number", "null"] },
                  "rr": { "type": ["string", "number", "null"] },
                  "dtl": { "type": ["string", "number", "null"] },
                  "cda": { "type": ["string", "number", "null"] },
                  "cda_up": { "type": ["string", "number", "null"] },
                  "cda_down": { "type": ["string", "number", "null"] },
