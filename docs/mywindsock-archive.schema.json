                                    "anyOf": [
                                      { "type": ["number", "null"] },
                                      {
                                        "type": "array",
                                        "prefixItems": [
                                          { "type": ["number", "null"] },
                                          { "type": ["number", "null"] }
                                        ],
                                        "items": false,
                                        "minItems": 2,
                                        "maxItems": 2
                                      }
                                    ]
                                  }
                                ],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              }
                            },
                            "scale": { "type": ["string", "null"] }
