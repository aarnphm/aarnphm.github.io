                "retrievedAt": { "type": "number", "minimum": 0 },
                "provider": { "type": "string", "const": "mywindsock" },
                "weatherImpactPct": { "type": ["number", "null"] },
                "cdaM2": { "type": ["number", "null"] },
                "feelsLikeElevationM": { "type": ["number", "null"] },
                "headwindPct": { "type": ["number", "null"] },
                "headwindMinKph": { "type": ["number", "null"] },
                "headwindMaxKph": { "type": ["number", "null"] },
                "longestHeadwindS": { "type": ["number", "null"] },
                "airSpeedKph": { "type": ["number", "null"] },
                "averageTemperatureC": { "type": ["number", "null"] },
                "precipitationProbabilityPct": { "type": ["number", "null"] },
                "precipitationRateMmPerHour": { "type": ["number", "null"] }
